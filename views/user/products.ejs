<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>PC Components | BuildaPC</title>

    <link rel="stylesheet" href="/user/css/home.css" />

    <link rel="stylesheet" href="/user/css/products.css" />
  </head>

  <body>
    <%-include("../../views/partials/user/header.ejs")%>

    <main class="products-page">
      <div class="products-container">
        <!-- Page title -->
        <h1 class="products-page-title">PC Components</h1>
        <div class="products-layout">
          <aside class="product-filters">
            <div class="filter-header">
              <h2>Filters</h2>
            </div>
            <!-- Categories -->
            <div class="filter-section">
              <h3>Categories</h3>
              <div class="category-filter-list">
                <% if (categories && categories.length > 0) { %> <% categories.forEach(categoryItem=> { %>
                <label class="category-filter-item">
                  <% if (category.includes(categoryItem._id.toString())) { %>
                  <input type="checkbox" name="category" value="<%= categoryItem._id %>" checked />
                  <% } else { %>
                  <input type="checkbox" name="category" value="<%= categoryItem._id %>" />
                  <% } %>
                  <span class="category-checkbox"></span>
                  <span class="category-name"> <%= categoryItem.name %> </span>
                  <span class="category-count"> (<%= categoryItem.productCount || 0 %>) </span>
                </label>
                <% }) %>
                <% } else { %>
                <p class="no-filter-data">No categories available</p>
                <% } %>
              </div>
            </div>
            <!-- Price -->
            <div class="filter-section price-filter-section">
              <h3>Price Range</h3>
              <div class="price-inputs">
                <div class="price-input-group">
                  <label for="minPrice"> Min </label>
                  <input
                    type="number"
                    id="minPrice"
                    name="minPrice"
                    placeholder="₹0"
                    value="<%= minPrice || '' %>"
                    min="0"
                  />
                </div>
                <div class="price-input-group">
                  <label for="maxPrice"> Max </label>
                  <input
                    type="number"
                    id="maxPrice"
                    name="maxPrice"
                    placeholder="₹1,00,000"
                    value="<%= maxPrice || '' %>"
                    min="0"
                  />
                </div>
              </div>
              <button type="button" class="apply-filter-btn">Apply Filter</button>
            </div>
          </aside>
          <!-- =========================
                     PRODUCT CONTENT
                ========================== -->
          <section class="products-content">
            <!-- =========================
                         TOP BAR
                    ========================== -->
            <div class="products-toolbar">
              <div class="product-result-count">
                <% const startProduct = totalProducts > 0 ? (currentPage - 1) * 6 + 1 : 0; const
                endProduct = Math.min(currentPage * 6, totalProducts); %>
                <span>
                  Showing
                  <%= startProduct %>-<%= endProduct %>
                  of
                  <%= totalProducts %>
                  products
                </span>
              </div>
              <!-- Sort -->
              <div class="product-sort">
                <label for="sortProducts"> Sort by: </label>

                <select id="sortProducts" name="sort">
                  <% if (sort === 'price_asc') { %>
                  <option value="price_asc" selected>Price: Low to High</option>
                  <% } else { %>
                  <option value="price_asc">Price: Low to High</option>
                  <% } %>

                  <% if (sort === 'price_desc') { %>
                  <option value="price_desc" selected>Price: High to Low</option>
                  <% } else { %>
                  <option value="price_desc">Price: High to Low</option>
                  <% } %>

                  <% if (sort === 'name_asc') { %>
                  <option value="name_asc" selected>A-Z</option>
                  <% } else { %>
                  <option value="name_asc">A-Z</option>
                  <% } %>

                  <% if (sort === 'name_desc') { %>
                  <option value="name_desc" selected>Z-A</option>
                  <% } else { %>
                  <option value="name_desc">Z-A</option>
                  <% } %>
                </select>
              </div>
            </div>

            <% if (search) { %>
            <div class="active-search">
              <span>
                Search results for:
                <strong>"<%= search %>"</strong>
              </span>
              <a href="/products" class="clear-search"> Cancel </a>
            </div>
            <% } %>

            <div class="products-grid">
              <% if (products && products.length > 0) { %> <% products.forEach(product => { %>
              <article class="product-card">
                <!-- Product Image -->
                <a href="/product/<%= product._id %>" class="product-image-link">
                  <div class="product-image-container">
                    <img
                      src="<%= product.primaryImage %>"
                      alt="<%= product.name %>"
                      class="product-image"
                    />
                  </div>
                </a>
                <!-- Product Information -->
                <div class="product-card-body">
                  <a href="/product/<%= product._id %>" class="product-name-link">
                    <h2 class="product-name"><%= product.name %></h2>
                  </a>

                  <% if (product.discountAmount > 0) { %>
                  <div class="product-pricing">
                    <p class="product-original-price">
                      ₹<%= Number(product.originalPrice).toLocaleString('en-IN') %>
                    </p>
                    <p class="product-price discounted">
                      ₹<%= Number(product.finalPrice).toLocaleString('en-IN') %>
                    </p>
                    <span class="product-offer-badge">
                      <%= product.discountPercentage %>% OFF
                    </span>
                  </div>
                  <% } else { %>
                  <p class="product-price">
                    ₹<%= Number(product.displayPrice).toLocaleString('en-IN') %>
                  </p>
                  <% } %>
                  <!-- Product Actions -->
                  <div class="product-card-actions">
                    <button
                      type="button"
                      class="add-cart-btn"
                      data-product-id="<%= product._id %>"
                      data-has-variants="<%= product.variantCount> 0 %>"
                    >
                      <span class="cart-icon"> 🛒 </span>
                      <span> Add to Cart </span>
                    </button>
                    <button
                      type="button"
                      class="wishlist-btn <%if(product.isInWishlist){%> checked<%}%>"
                      data-product-id="<%= product._id %>"
                      data-has-variants="<%=product.variantCount>0 %>"
                      aria-label="Add to wishlist"
                    >
                      <span class="wishlist-icon"> <%= product.isInWishlist ? '♥' : '♡' %> </span>
                    </button>
                  </div>
                </div>
              </article>
              <% }) %>
              <% } else { %>
              <!-- No products -->
              <div class="no-products">
                <h2>No products found</h2>
                <p>Try changing your search or filters.</p>

                <a href="/products" class="clear-products-btn"> Clear Filters </a>
              </div>
              <% } %>
            </div>

            <% if (totalPages >1) { %>
            <nav class="product-pagination" aria-label="Product pagination">
              <% if (currentPage > 1) { %>
              <a href="/products?page=<%= currentPage - 1 %>" class="pagination-btn"> Previous </a>
              <% } else { %>
              <span class="pagination-btn disabled"> Previous </span>
              <% } %>
              <% for (let i = 1; i <= totalPages; i++) { %>
              <a
                href="/products?page=<%= i %>"
                class="pagination-number <%= currentPage === i ? 'active' : '' %>"
              >
                <%= i %>
              </a>
              <% } %>
              <% if (currentPage < totalPages) { %>
              <a href="/products?page=<%= currentPage + 1 %>" class="pagination-btn"> Next </a>
              <% } else { %>
              <span class="pagination-btn disabled"> Next </span>
              <% } %>
            </nav>
            <% } %>
          </section>
        </div>
      </div>
    </main>
    <%-include("../../views/partials/user/footer.ejs")%>

    <script src="/user/js/products.js"></script>
  </body>
</html>
