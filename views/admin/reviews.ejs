<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Review Management</title>

    <link rel="stylesheet" href="/admin/css/admin-base.css" />
    <link rel="stylesheet" href="/admin/css/reviews.css" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    />
  </head>

  <body>
    <div class="admin-wrapper">
      <%- include("../partials/admin/sidebar", { active: 'reviews' }) %>

      <div class="admin-content">
        <%- include('../partials/admin/topbar') %>

        <div class="top-bar">
          <div>
            <h1 class="page-title">Review Management</h1>
            <p class="page-subtitle">Manage customer reviews and ratings</p>
          </div>
        </div>
        <div id="reviewMessage" class="review-message"></div>

        <div class="review-card">
          <div class="review-search">
            <form method="GET" action="/admin/reviews" class="search-form">
              <input
                type="text"
                name="search"
                placeholder="Search reviews..."
                value="<%= search || '' %>"
              />
              <button type="submit" class="search-btn">Search</button>
              <% if (search) { %>
              <a href="/admin/reviews" class="clear-search"> Cancel </a>
              <% } %>
            </form>
          </div>

          <table class="review-table">
            <thead>
              <tr>
                <th>Product</th>
                <th>Customer</th>
                <th>Rating</th>
                <th>Review</th>
                <th>Date</th>
                <th>Status</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% if (reviews && reviews.length > 0) { %> <% reviews.forEach(review => { %>
              <tr id="review-<%= review._id %>">
                <td>
                  <%= review.productId?.name || 'Product removed' %>
                </td>

                <td>
                  <%= review.userId?.name || 'User removed' %>
                </td>

                <td>
                  <span class="review-rating-numbeer"> <%=review.rating%>/5 </span>
                </td>

                <td>
                  <div class="review-comment"><%= review.comment %></div>
                </td>

                <td>
                  <%= new Date(
                                        review.createdAt
                                    ).toLocaleDateString('en-IN') %>
                </td>

                <td>
                  <% if (review.isVisible) { %>
                  <span class="review-status visible"> Visible </span>
                  <% } else { %>
                  <span class="review-status hidden"> Hidden </span>
                  <% } %>
                </td>

                <td>
                  <div class="review-actions">
                    <a
                      href="#"
                      class="review-action-link view"
                      onclick="
                        viewReview('<%= review._id %>');
                        return false;
                      "
                    >
                      View
                    </a>
                    <% if (review.isVisible) { %>
                    <a
                      href="#"
                      class="review-action-link hide"
                      onclick="
                        toggleReviewStatus('<%= review._id %>', false);
                        return false;
                      "
                    >
                      Hide
                    </a>
                    <% } else { %>
                    <a
                      href="#"
                      class="review-action-link show"
                      onclick="
                        toggleReviewStatus('<%= review._id %>', true);
                        return false;
                      "
                    >
                      Show
                    </a>
                    <% } %>
                    <a
                      href="#"
                      class="review-action-link delete"
                      onclick="
                        deleteReview('<%= review._id %>');
                        return false;
                      "
                    >
                      Delete
                    </a>
                  </div>
                </td>
              </tr>
              <% }) %>
              <% } else { %>

              <tr>
                <td colspan="7" class="no-reviews">No reviews found.</td>
              </tr>
              <% } %>
            </tbody>
          </table>

          <% if (totalPages > 1) { %>
          <div class="review-pagination">
            <% for ( let i = 1; i <= totalPages; i++ ) { %>
            <a
              href="/admin/reviews?page=<%= i %>&search=<%= encodeURIComponent(search || '') %>"
              class="<%= currentPage === i ? 'active' : '' %>"
            >
              <%= i %>
            </a>
            <% } %>
          </div>
          <% } %>
        </div>
      </div>
    </div>
    <div id="reviewDetailsModal" class="review-modal-overlay" style="display: none">
      <div class="review-modal">
        <div class="review-modal-header">
          <h2>Review Details</h2>
          <button type="button" class="review-modal-close" onclick="closeReviewModal()">
            &times;
          </button>
        </div>
        <div class="review-modal-body">
          <div class="review-detail-row">
            <span>Product</span>
            <strong id="modalReviewProduct"></strong>
          </div>
          <div class="review-detail-row">
            <span>Customer</span>
            <strong id="modalReviewCustomer"></strong>
          </div>
          <div class="review-detail-row">
            <span>Rating</span>
            <strong id="modalReviewRating"></strong>
          </div>
          <div class="review-detail-row review-comment-row">
            <span>Review</span>
            <p id="modalReviewComment"></p>
          </div>
          <div class="review-detail-row">
            <span>Date</span>
            <strong id="modalReviewDate"></strong>
          </div>
          <div class="review-detail-row">
            <span>Status</span>
            <strong id="modalReviewStatus"></strong>
          </div>
        </div>
        <div class="review-modal-footer">
          <button type="button" onclick="closeReviewModal()" class="review-modal-close-btn">
            Close
          </button>
        </div>
      </div>
    </div>
    <script>

          const adminReviews =<%- JSON.stringify(reviews) %>;
          function showReviewMessage(message, type) {
              const messageBox = document.getElementById('reviewMessage');
              messageBox.textContent = message;
              messageBox.className =`review-message ${type}`;
              setTimeout(() => {
                  messageBox.textContent = '';
                  messageBox.className =
                      'review-message';
              }, 3000);
          }
          async function toggleReviewStatus(reviewId,isVisible) {
              const action = isVisible ? 'show' : 'hide';
              const confirmed =
                  confirm(
                      `Are you sure you want to ${action} this review?`
                  );
              if (!confirmed) {
                  return;
              }
              try {
                  const response = await fetch(
                          `/admin/reviews/${reviewId}/status`,
                          {
                              method: 'PATCH',
                              headers: {
                                  'Content-Type':'application/json'
                              },
                              body: JSON.stringify({
                                  isVisible: isVisible
                              })
                          }
                      );
                  const result =await response.json();
                  if ( !response.ok ||!result.success) {
                      throw new Error( result.message || `Failed to ${action} review`);
                  }
                  showReviewMessage(
                      result.message,
                      'success'
                  );
                  setTimeout(() => {
                      window.location.reload();
                  }, 1000);

              } catch (error) {
                  console.error('Review status error:', error);
                  showReviewMessage(error.message ||`Failed to ${action} review`,'error');
              }
          }
          async function deleteReview(reviewId) {
              const confirmed =confirm('Are you sure you want to delete this review?');

              if (!confirmed) {
                  return;
              }
              try {
                  const response =await fetch(
                          `/admin/reviews/${reviewId}`,
                          {
                              method: 'DELETE'
                          }
                      );
                  const result =await response.json();
                  if (!response.ok ||!result.success) {
                      throw new Error(result.message ||'Failed to delete review' );
                  }
                  showReviewMessage('Review deleted successfully','success');
                  const reviewRow =
                      document.getElementById(
                          `review-${reviewId}`
                      );
                  if (reviewRow) {
                      reviewRow.remove();
                  }
              } catch (error) {
                  console.error('Delete review error:',error);
                  showReviewMessage(error.message ||'Failed to delete review','error');
              }
          }
          function viewReview(reviewId) {
          const review = adminReviews.find(item => item._id === reviewId
          );
          if (!review) {
              showReviewMessage('Review not found','error');
              return;
          }
          document.getElementById('modalReviewProduct').textContent =review.productId?.name || 'Product removed';
          document.getElementById('modalReviewCustomer').textContent = review.userId?.name || 'User removed';
          document.getElementById('modalReviewRating').textContent =`${review.rating}/5`;
          document.getElementById('modalReviewComment').textContent =review.comment;
          document.getElementById('modalReviewDate').textContent = new Date(review.createdAt).toLocaleDateString('en-IN');
          document.getElementById('modalReviewStatus').textContent = review.isVisible? 'Visible': 'Hidden';
          document.getElementById('reviewDetailsModal').style.display = 'flex';
      }
      function closeReviewModal() {
          document.getElementById('reviewDetailsModal').style.display = 'none';
      }
    </script>
  </body>
</html>
