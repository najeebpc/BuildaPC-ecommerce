<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>BuildaPC - Login</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- Google Font: Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&display=swap" rel="stylesheet">

  <!-- Common auth styles for ALL auth pages -->
  <link rel="stylesheet" href="user/css/auth.css">
</head>
<body>

  <div class="auth-page">
    <!-- <div class="auth-alert success-alert"> -->
  <% if ( message&&(field==='passChange'||field==='isBlocked')) { %>
  <div class="alert-content <%= field==='isBlocked'?'error-alert':'success-alert'%> auth-alert">
    <span><%= message %></span>
  </div>
   <% } %>
<!-- </div> -->
    <div class="auth-card">

      <!-- CENTERED HEADER -->
      <div class="auth-header">
        <div class="auth-logo">BuildaPC</div>
        <h1 class="auth-title">Login to Your Account</h1>
        <p class="auth-subtext">Enter your details to continue</p>
      </div>

      <!-- SIGNUP FORM -->
      <form class="auth-form" id="signForm" action="/login" method="POST">

        <!-- Email -->
        <div class="form-group">
          <label for="email">Email</label>
          <input
            id="email"
            name="email"
            placeholder="Enter your email"
            value="<%= formData.email || ''%> "
          />
          <p class="error-text" id="mailError"><% if(field === "email" && message){ %>
            <%=message %>
            <% } %>
            </p>
        </div>
        

        <!-- Password -->
        <div class="form-group">
          <label for="password">Password</label>
          <input
            type="password";
            id="password"
            name="password"
            placeholder="Enter your password"
            
          />
          <p class="error-text" id="passError"><% if(field === "password" && message){ %>
            <%=message %>
            <% } %>
            </p>
        </div>

        <div class="auth-options">
      
        <a href="/forgot-password" class="forgot-link">Forgot Password?</a>
      </div>
        <!-- Signup Button -->
        <button type="submit" class="btn-primary">Login</button>

        <!-- Divider -->
        <div class="divider">
          <span>or continue with</span>
        </div>

        <!-- Google Button -->
        <a href="/auth/google"><button type="button" class="btn-google">
          Sign in  with Google
        </button></a>
      </form>

      <!-- Footer -->
      <div class="auth-footer">
         Don't have an account? <a href="/signup">Sign Up</a>
      </div>

    </div>
  </div>


  <script>
    const form = document.getElementById('signForm');
    const emailInput = document.getElementById('email');
    const passwordInput = document.getElementById('password');
    const mailerror = document.getElementById('mailError');
    const passerror = document.getElementById('passError');

    form.addEventListener('submit',(e)=>{
      mailerror.textContent = "";
      passerror.textContent = "";

      const email = emailInput.value.trim();
      const password = passwordInput.value.trim();
      if(!email){
        e.preventDefault();
        mailerror.textContent = "Email is required";
        return;
      }
      if(!validateEmail(email)){
        e.preventDefault();
        mailerror.textContent= "Eneter a valid email";
        return;
      }
      if(!password){
        e.preventDefault();
        passerror.textContent = "Password is required";
        return;
      }
    })
  function validateEmail(email){
    return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
  }
  </script>
</body>
</html>