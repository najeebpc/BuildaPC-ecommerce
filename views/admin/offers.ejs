<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Offer Management</title>

    <link rel="stylesheet" href="/admin/css/admin-base.css" />
    <link rel="stylesheet" href="/admin/css/offers.css" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
    />
  </head>
  <body>
    <div class="admin-wrapper">
      <%- include('../partials/admin/sidebar', { active: 'offers' }) %>

      <main class="admin-content">
        <%- include('../partials/admin/topbar') %>

        <section class="offers-page">
          <div class="offers-page-header">
            <div>
              <h1 class="offers-page-title">Offer Management</h1>
              <p class="offers-page-subtitle">Create and manage product and category offers</p>
            </div>

            <button type="button" class="offer-primary-btn" onclick="openAddOfferModal()">
              <i class="fas fa-plus"></i>
              Add Offer
            </button>
          </div>

          <% if (typeof message !== 'undefined' && message) { %>
          <div class="offer-alert"><%= message %></div>
          <% } %>

          <div class="offer-card">
            <div class="offer-table-wrapper">
              <table class="offer-table">
                <thead>
                  <tr>
                    <th>Offer Type</th>
                    <th>Target</th>
                    <th>Discount</th>
                    <th>Start Date</th>
                    <th>End Date</th>
                    <th>Status</th>
                    <th>Actions</th>
                  </tr>
                </thead>

                <tbody>
                  <% if (offers && offers.length > 0) { %> <% offers.forEach(offer => { %> <% const
                  now = new Date(); const start = new Date(offer.startDate); const end = new
                  Date(offer.endDate); let statusText = 'Inactive'; let statusClass = 'inactive'; if
                  (!offer.isActive) { statusText = 'Inactive'; statusClass = 'inactive'; } else if
                  (now < start) { statusText = 'Upcoming'; statusClass = 'upcoming'; } else if (now
                  > end) { statusText = 'Expired'; statusClass = 'expired'; } else { statusText =
                  'Active'; statusClass = 'active'; } const targetName = offer.offerType ===
                  'product' ? (offer.productId && offer.productId.name ? offer.productId.name :
                  'Product unavailable') : (offer.categoryId && offer.categoryId.name ?
                  offer.categoryId.name : 'Category unavailable'); %>

                  <tr>
                    <td>
                      <span class="offer-type-badge <%= offer.offerType %>">
                        <%= offer.offerType === 'product' ? 'Product Offer' : 'Category Offer' %>
                      </span>
                    </td>

                    <td class="offer-target"><%= targetName %></td>

                    <td>
                      <span class="offer-discount"> <%= offer.discountPercentage %>% </span>
                    </td>

                    <td>
                      <%= start.toLocaleDateString('en-IN') %>
                    </td>

                    <td>
                      <%= end.toLocaleDateString('en-IN') %>
                    </td>

                    <td>
                      <span class="offer-status <%= statusClass %>"> <%= statusText %> </span>
                    </td>

                    <td>
                      <div class="offer-actions">
                        <button
                          type="button"
                          class="offer-icon-btn edit"
                          title="Edit offer"
                          data-id="<%= offer._id %>"
                          data-type="<%= offer.offerType %>"
                          data-discount="<%= offer.discountPercentage %>"
                          data-product="<%= offer.productId ? offer.productId._id : '' %>"
                          data-category="<%= offer.categoryId ? offer.categoryId._id : '' %>"
                          data-start="<%= offer.startDate.toISOString() %>"
                          data-end="<%= offer.endDate.toISOString() %>"
                          onclick="openEditOfferModal(this)"
                        >
                          <i class="fas fa-pen"></i>
                        </button>

                        <label class="offer-switch" title="Enable or disable offer">
                          <% if (offer.isActive) { %>
                          <input
                            type="checkbox"
                            checked
                            onchange="toggleOfferStatus('<%= offer._id %>', this.checked)"
                          />
                          <% } else { %>
                          <input
                            type="checkbox"
                            onchange="toggleOfferStatus('<%= offer._id %>', this.checked)"
                          />
                          <% } %>
                          <span class="offer-switch-slider"></span>
                        </label>

                        <button
                          type="button"
                          class="offer-icon-btn delete"
                          title="Delete offer"
                          onclick="openDeleteOfferModal('<%= offer._id %>')"
                        >
                          <i class="fas fa-trash"></i>
                        </button>
                      </div>
                    </td>
                  </tr>
                  <% }) %>
                  <% } else { %>
                  <tr>
                    <td colspan="7" class="offer-empty">
                      <i class="fas fa-tags"></i>
                      <p>No offers found</p>
                      <span>Create your first product or category offer.</span>
                    </td>
                  </tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </section>
      </main>
    </div>

    <div class="offer-modal-overlay" id="offerModal">
      <div class="offer-modal" role="dialog" aria-modal="true" aria-labelledby="offerModalTitle">
        <div class="offer-modal-header">
          <div>
            <h2 id="offerModalTitle">Add Offer</h2>
            <p>Configure the discount and offer validity</p>
          </div>

          <button
            type="button"
            class="offer-modal-close"
            onclick="closeOfferModal()"
            aria-label="Close modal"
          >
            <i class="fas fa-times"></i>
          </button>
        </div>

        <form id="offerForm">
          <div class="offer-modal-body">
            <input type="hidden" id="offerId" name="offerId" />

            <div class="offer-form-grid">
              <div class="offer-form-group">
                <label for="offerType">Offer Type <span>*</span></label>
                <select id="offerType" name="offerType" required>
                  <option value="">Select offer type</option>
                  <option value="product">Product Offer</option>
                  <option value="category">Category Offer</option>
                </select>
              </div>

              <div class="offer-form-group">
                <label for="discountPercentage"> Discount Percentage <span>*</span> </label>
                <div class="offer-percentage-input">
                  <input
                    type="number"
                    id="discountPercentage"
                    name="discountPercentage"
                    min="0.01"
                    max="100"
                    step="0.01"
                    placeholder="e.g. 15"
                    required
                  />
                  <span>%</span>
                </div>
                <small>Enter a value greater than 0 and up to 100.</small>
              </div>

              <div class="offer-form-group offer-target-group" id="productTargetGroup">
                <label for="productId">Product <span>*</span></label>
                <select id="productId" name="productId">
                  <option value="">Select product</option>
                  <% if (products && products.length > 0) { %> <% products.forEach(product => { %>
                  <option value="<%= product._id %>"><%= product.name %></option>
                  <% }) %>
                  <% } %>
                </select>
              </div>

              <div class="offer-form-group offer-target-group" id="categoryTargetGroup">
                <label for="categoryId">Category <span>*</span></label>
                <select id="categoryId" name="categoryId">
                  <option value="">Select category</option>
                  <% if (categories && categories.length > 0) { %> <% categories.forEach(category =>
                  { %>
                  <option value="<%= category._id %>"><%= category.name %></option>
                  <% }) %>
                  <% } %>
                </select>
              </div>

              <div class="offer-form-group">
                <label for="startDate">Start Date <span>*</span></label>
                <input type="datetime-local" id="startDate" name="startDate" required />
              </div>

              <div class="offer-form-group">
                <label for="endDate">End Date <span>*</span></label>
                <input type="datetime-local" id="endDate" name="endDate" required />
              </div>
            </div>

            <div class="offer-form-error" id="offerFormError" role="alert" hidden></div>
          </div>

          <div class="offer-modal-footer">
            <button
              type="button"
              class="offer-secondary-btn"
              id="cancelOfferBtn"
              onclick="closeOfferModal()"
            >
              Cancel
            </button>

            <button type="submit" class="offer-primary-btn" id="saveOfferBtn">Save Offer</button>
          </div>
        </form>
      </div>
    </div>

    <div class="offer-modal-overlay" id="deleteOfferModal">
      <div
        class="offer-delete-modal"
        role="dialog"
        aria-modal="true"
        aria-labelledby="deleteOfferTitle"
      >
        <div class="offer-delete-icon">
          <i class="fas fa-trash-alt"></i>
        </div>

        <h2 id="deleteOfferTitle">Delete Offer?</h2>
        <p>Are you sure you want to delete this offer? This action cannot be undone.</p>

        <div class="offer-delete-footer">
          <button type="button" class="offer-secondary-btn" onclick="closeDeleteOfferModal()">
            Cancel
          </button>

          <button
            type="button"
            class="offer-danger-btn"
            id="confirmDeleteOfferBtn"
            onclick="confirmDeleteOffer()"
          >
            Delete Offer
          </button>
        </div>
      </div>
    </div>

    <script src="/admin/js/offers.js"></script>
  </body>
</html>
