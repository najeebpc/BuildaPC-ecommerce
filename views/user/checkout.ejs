<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Order Summary | BuildaPC</title>
    <link rel="stylesheet" href="/user/css/home.css" />
    <link rel="stylesheet" href="/user/css/checkout.css" />
  </head>

  <body data-selected-address-id="<%= selectedAddress ? selectedAddress._id : '' %>">
    <%- include('../../views/partials/user/header.ejs') %>

    <main class="checkout-page">
      <div class="checkout-progress">
        <div class="progress-step active">
          <div class="progress-circle">1</div>
          <span> Order Summary </span>
        </div>

        <div class="progress-line active"></div>

        <div class="progress-step">
          <div class="progress-circle">2</div>
          <span> Payment </span>
        </div>
      </div>

      <div class="checkout-content">
        <h1 class="checkout-title">Review Your Order</h1>
        <div class="checkout-container">
          <div class="checkout-left">
            <section class="checkout-section delivery-address">
              <div class="address-header">
                <h2 class="address-title">
                  <svg
                    class="address-icon"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z"></path>
                    <circle cx="12" cy="10" r="2.5"></circle>
                  </svg>
                  Delivery Address
                </h2>
                <% if (addresses&&addresses.length>0) { %>
                <button type="button" class="change-address-btn" id="changeAddressBtn">
                  Change
                </button>
                <% } %>
              </div>
              <% if (selectedAddress) { %>

              <div class="selected-address">
                <h3 class="address-name"><%= selectedAddress.fullName %></h3>
                <p class="address-details">
                  <%= selectedAddress.addressLine1 %> <% if (selectedAddress.addressLine2) { %> ,
                  <%= selectedAddress.addressLine2 %> <% } %> , <%= selectedAddress.city %> , <%=
                  selectedAddress.state %> - <%= selectedAddress.pincode %>
                </p>
                <p class="address-phone">Phone: <%= selectedAddress.phone %></p>
              </div>
              <% } else { %>

              <div class="no-address">
                <p>No delivery address found.</p>
                <button type="button" id="addAddressBtn" class="add-address-btn">
                  + Add New Address
                </button>
              </div>
              <% } %>

              <% if (addresses && addresses.length > 0) { %>
              <div class="checkout-address-list" id="checkoutAddressList">
                <div class="checkout-address-list-header">
                  <h3>Select Delivery Address</h3>
                </div>
                <% addresses.forEach(address => { %>
                <div
                  class="checkout-address-option <%= selectedAddress && String(selectedAddress._id) === String(address._id) ? 'selected' : '' %>"
                  data-address-id="<%=address._id %>"
                >
                  <div class="checkout-address-content">
                    <div class="checkout-address-top">
                      <h4>
                        <%= address.fullName %>
                      </h4>
                      <% if (address.isDefault) { %>
                      <span class="default-address-label"> Default </span>
                      <% } %>
                    </div>
                    <p>
                      <%= address.addressLine1 %> <% if (address.addressLine2) { %> , <%=
                      address.addressLine2 %> <% } %> , <%= address.city %>, <%= address.state %> -
                      <%= address.pincode %>
                    </p>
                    <span class="checkout-address-phone"> Phone: <%= address.phone %> </span>
                  </div>
                  <div class="checkout-address-actions">
                    <a href="/account/address" class="checkout-edit-address"> Edit </a>
                    <button type="button" class="select-address-btn">Select</button>
                  </div>
                </div>
                <% }) %>

                <button type="button" class="checkout-add-address" id="checkoutAddAddressBtn">
                  + Add New Address
                </button>
              </div>
              <% } %>
            </section>

            <section class="checkout-section order-items-section">
              <h2 class="order-items-title">Order Items</h2>
              <% items.forEach(item => { %>
              <div class="checkout-item">
                <img
                  src="<%= item.productId.primaryImage %>"
                  alt="<%= item.productId.name %>"
                  class="checkout-item-image"
                />

                <div class="checkout-item-details">
                  <h3 class="checkout-item-name"><%= item.productId.name %></h3>
                  <% if (item.variantId) { %>
                  <% item.variantId.attributes.forEach(attribute => { %>
                  <p class="checkout-item-variant"><%= attribute.name %>: <%= attribute.value %></p>
                  <% }) %>
                  <% } %>
                  <p class="checkout-item-quantity">Qty: <%= item.quantity %></p>

                  <p class="checkout-item-price">
                    <% const originalPrice = Number( item.originalPrice ?? (item.variantId ?
                    item.variantId.price : item.productId.basePrice) ); %> <% const discountAmount =
                    Number(item.discountAmount ?? 0); %> <% const finalPrice = Number(
                    item.finalPrice ?? (originalPrice - discountAmount) ); %> <% if (discountAmount
                    > 0) { %>
                    <span class="checkout-original-price">
                      ₹<%= originalPrice.toLocaleString('en-IN') %>
                    </span>

                    <span class="checkout-discounted-price">
                      ₹<%= finalPrice.toLocaleString('en-IN') %>
                    </span>

                    <span class="checkout-offer-badge">
                      <%= Number(item.discountPercentage ?? Math.round((discountAmount /
                      originalPrice) * 100)) %>% OFF
                    </span>
                    <% } else { %>
                    <span class="checkout-regular-price">
                      ₹<%= originalPrice.toLocaleString('en-IN') %>
                    </span>
                    <% } %>

                    <span class="checkout-item-line-total">
                      Item total: ₹<%= Number(finalPrice * item.quantity).toLocaleString('en-IN') %>
                    </span>
                  </p>
                </div>
              </div>
              <% }) %>
            </section>
          </div>

          <aside class="order-summary">
            <h2 class="order-summary-title">Order Summary</h2>

            <% const originalSubtotal = items.reduce((total, item) => { const price = Number(
            item.originalPrice ?? (item.variantId ? item.variantId.price : item.productId.basePrice)
            ); return total + price * item.quantity; }, 0); const offerSavings =
            items.reduce((total, item) => { const discount = Number(item.discountAmount ?? 0);
            return total + discount * item.quantity; }, 0); const subtotal = Math.max(0,
            originalSubtotal - offerSavings); const totalItems = items.reduce( (total, item) =>
            total + item.quantity, 0 ); %>

            <div class="summary-row">
              <span>
                Subtotal (<%= totalItems %>
                items)
              </span>
              <span class="summary-price"> ₹<%= Number(subtotal).toLocaleString('en-IN') %> </span>
            </div>

            <% if (offerSavings > 0) { %>
            <div class="summary-row offer-savings-row">
              <span>Offer Savings</span>
              <span class="summary-price offer-savings-price">
                −₹<%= Number(offerSavings).toLocaleString('en-IN') %>
              </span>
            </div>
            <% } %>

            <div class="summary-row">
              <span> Shipping Charge </span>
              <span class="shipping-free"> Free </span>
            </div>

            <div
              class="coupon-section"
              id="couponSection"
              data-applied-coupon="<%-JSON.stringify(
                            appliedCoupon?{
                                code:appliedCoupon.code,
                                discount:appliedCoupon.discount,
                                payableAmount:appliedCoupon.payableAmount
                            }:null
                         ) %>"
            >
              <label for="couponCode" class="coupon-title"> Apply Coupon </label>
              <div class="coupon-form">
                <input
                  type="text"
                  id="couponCode"
                  class="coupon-input"
                  placeholder="Enter coupon code"
                  autocomplete="off"
                />
                <button type="button" class="coupon-btn" id="applyCouponBtn">Apply</button>
              </div>
              <p id="couponMessage" class="coupon-message" hidden></p>
              <div id="appliedCoupon" class="applied-coupon" hidden>
                <div>
                  <strong id="appliedCouponCode"></strong>
                  <p>Coupon applied</p>
                </div>
                <button type="button" id="removeCouponBtn">Remove</button>
              </div>
            </div>

            <div class="summary-row" id="couponDiscountRow" hidden>
              <span>Coupon Discount</span>
              <span class="summary-price" id="couponDiscountAmount"> −₹0 </span>
            </div>

            <div class="summary-divider"></div>

            <div class="summary-total">
              <span> Total </span>
              <span
                class="summary-total-price"
                id="checkoutTotal"
                data-subtotal="<%=Number(subtotal)%>"
              >
                ₹<%= Number(subtotal).toLocaleString('en-IN') %>
              </span>
            </div>

            <button type="button" class="continue-payment-btn">Continue to Payment</button>

            <a href="/cart">
              <button type="button" class="back-address-btn">Back to Cart</button>
            </a>
          </aside>
        </div>
      </div>
    </main>

    <div class="checkout-address-modal" id="checkoutAddressModal">
      <div class="checkout-address-modal-overlay"></div>
      <div class="checkout-address-modal-box">
        <div class="checkout-address-modal-header">
          <h3>Add New Address</h3>
          <button type="button" id="closeCheckoutAddressModal" class="checkout-address-modal-close">
            ×
          </button>
        </div>
        <form id="checkoutAddressForm">
          <div class="row-2">
            <div class="form-group">
              <label for="checkoutFullName"> Full Name </label>
              <input type="text" id="checkoutFullName" name="fullName" placeholder="Full Name" />
              <p class="error-text" id="checkoutFullNameError"></p>
            </div>
            <div class="form-group">
              <label for="checkoutPhone"> Phone Number </label>
              <input type="text" id="checkoutPhone" name="phone" placeholder="Phone Number" />
              <p class="error-text" id="checkoutPhoneError"></p>
            </div>
          </div>
          <div class="form-group">
            <label for="checkoutAddressLine1"> Address </label>
            <input
              type="text"
              id="checkoutAddressLine1"
              name="addressLine1"
              placeholder="House No., Building Name"
            />
            <p class="error-text" id="checkoutAddressLine1Error"></p>
          </div>
          <div class="form-group">
            <label for="checkoutAddressLine2"> Area / Road </label>
            <input
              type="text"
              id="checkoutAddressLine2"
              name="addressLine2"
              placeholder="Road name, Area, Colony"
            />
            <p class="error-text" id="checkoutAddressLine2Error"></p>
          </div>
          <div class="row-2">
            <div class="form-group">
              <label for="checkoutCity"> City </label>
              <input type="text" id="checkoutCity" name="city" placeholder="City" />
              <p class="error-text" id="checkoutCityError"></p>
            </div>
            <div class="form-group">
              <label for="checkoutState"> State </label>

              <select id="checkoutState" name="state">
                <option value="">Select State</option>

                <option value="Kerala">Kerala</option>

                <option value="Karnataka">Karnataka</option>
              </select>
              <p class="error-text" id="checkoutStateError"></p>
            </div>
          </div>
          <div class="form-group">
            <label for="checkoutPincode"> Pincode </label>
            <input
              type="text"
              id="checkoutPincode"
              name="pincode"
              placeholder="Pincode"
              maxlength="6"
            />
            <p class="error-text" id="checkoutPincodeError"></p>
          </div>
          <div class="checkout-address-modal-actions">
            <button type="button" id="cancelCheckoutAddress" class="address-cancel-btn">
              Cancel
            </button>
            <button type="submit" id="saveCheckoutAddress" class="address-confirm-btn">
              Save Address
            </button>
          </div>
        </form>
      </div>
    </div>

    <%- include('../../views/partials/user/footer.ejs') %>
    <script src="/user/js/checkout.js"></script>
  </body>
</html>
