<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Order Management</title>
    <link rel="stylesheet" href="/admin/css/admin-base.css" />
    <link rel="stylesheet" href="/admin/css/orders.css" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    />
  </head>
  <body>
    <div class="admin-wrapper">
      <%- include("../partials/admin/sidebar", { active: 'orders' }) %>
      <div class="admin-content">
        <%- include('../partials/admin/topbar') %>

        <div class="top-bar">
          <div>
            <h1 class="page-title">Order Management</h1>
            <p class="page-subtitle">Track and manage customer orders</p>
          </div>
        </div>
        <!-- ORDER CARD -->
        <div class="order-card">
          <!-- SEARCH -->
          <div class="order-toolbar">
            <form method="GET" action="/admin/orders" class="order-search-form">
              <input
                type="text"
                name="search"
                placeholder="Search orders by ID or customer name..."
                value="<%= search || '' %>"
              />
              <button type="submit" class="search-btn">Search</button>
              <% if (search || status || sort !== 'newest') { %>
              <a href="/admin/orders" class="clear-search"> Clear </a>
              <% } %>
            </form>
            <!-- FILTER -->
            <div class="order-filters">
              <select id="orderStatusFilter" onchange="applyOrderFilters()">
                <option value="">All Orders</option>
                <% if (status === 'pending') { %>
                <option value="pending" selected>Pending</option>
                <% } else { %>
                <option value="pending">Pending</option>
                <% } %>
                <% if (status === 'shipped') { %>
                <option value="shipped" selected>Shipped</option>
                <% } else { %>
                <option value="shipped">Shipped</option>
                <% } %>
                <% if (status === 'out for delivery') { %>
                <option value="out for delivery" selected>Out for Delivery</option>
                <% } else { %>
                <option value="out for delivery">Out for Delivery</option>
                <% } %>
                <% if (status === 'delivered') { %>
                <option value="delivered" selected>Delivered</option>
                <% } else { %>
                <option value="delivered">Delivered</option>
                <% } %>
                <% if (status === 'cancelled') { %>
                <option value="cancelled" selected>Cancelled</option>
                <% } else { %>
                <option value="cancelled">Cancelled</option>
                <% } %>
              </select>
              <!-- SORT -->
              <select id="orderSort" onchange="applyOrderFilters()">
                <% if (sort === 'newest') { %>
                <option value="newest" selected>Newest First</option>
                <% } else { %>
                <option value="newest">Newest First</option>
                <% } %>
                <% if (sort === 'oldest') { %>
                <option value="oldest" selected>Oldest First</option>
                <% } else { %>
                <option value="oldest">Oldest First</option>
                <% } %>
              </select>
            </div>
          </div>
          <!-- TABLE -->
          <div class="order-table-wrapper">
            <table class="order-table">
              <thead>
                <tr>
                  <th>Order ID</th>
                  <th>Customer</th>
                  <th>Order Total</th>
                  <th>Date</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% if (orders && orders.length > 0) { %> <% orders.forEach(order => { %>
                <tr>
                  <td>
                    <%= order.orderId %>
                  </td>

                  <td>
                    <div class="customer-info">
                      <strong>
                        <%= order.userId?.name || 'User removed' %>
                      </strong>
                      <span>
                        <%= order.userId?.email || '' %>
                      </span>
                    </div>
                  </td>

                  <td>
                    ₹<%= Number(
                                        order.totalAmount
                                    ).toLocaleString('en-IN') %>
                  </td>

                  <td>
                    <%= new Date(
                                        order.createdAt
                                    ).toLocaleDateString('en-IN') %>
                  </td>

                  <td>
                    <div class="order-actions">
                      <a href="/admin/orders/<%= order.orderId %>" class="view-order-btn">
                        View Details
                      </a>
                      <select
                        class="order-status-select"
                        data-order-id="<%= order.orderId %>"
                        onchange="updateOrderStatus(this)"
                      >
                        <% if (order.orderStatus === 'pending') { %>
                        <option value="pending" selected>Pending</option>
                        <% } else { %>
                        <option value="pending">Pending</option>
                        <% } %>

                        <% if (order.orderStatus === 'shipped') { %>
                        <option value="shipped" selected>Shipped</option>
                        <% } else { %>
                        <option value="shipped">Shipped</option>
                        <% } %>

                        <% if (order.orderStatus === 'out for delivery') { %>
                        <option value="out for delivery" selected>Out for Delivery</option>
                        <% } else { %>
                        <option value="out for delivery">Out for Delivery</option>
                        <% } %>

                        <% if (order.orderStatus === 'delivered') { %>
                        <option value="delivered" selected>Delivered</option>
                        <% } else { %>
                        <option value="delivered">Delivered</option>
                        <% } %>

                        <% if (order.orderStatus === 'cancelled') { %>
                        <option value="cancelled" selected>Cancelled</option>
                        <% } else { %>
                        <option value="cancelled">Cancelled</option>
                        <% } %>
                      </select>
                      <% if (order.items.some(item=>item.returnStatus === 'requested')) { %>
                      <a href="/admin/orders/<%= order.orderId %>" class="review-return-btn">
                        <i class="fa-solid fa-bell"></i>
                        Review Return
                      </a>
                      <% } %>
                    </div>
                  </td>
                </tr>
                <% }) %>
                <% } else { %>
                <tr>
                  <td colspan="5" class="order-empty">No orders found.</td>
                </tr>
                <% } %>
              </tbody>
            </table>
          </div>

          <% if (totalPages > 1) { %>
          <div class="order-pagination">
            <% for ( let i = 1; i <= totalPages; i++ ) { %>
            <a
              href="/admin/orders?page=<%= i %>&search=<%= encodeURIComponent(search || '') %>&status=<%= encodeURIComponent(status || '') %>&sort=<%= sort %>"
              class="<%= currentPage === i ? 'active' : '' %>"
            >
              <%= i %>
            </a>
            <% } %>
          </div>
          <% } %>
        </div>
      </div>
    </div>
    <script src="/admin/js/orders.js"></script>
  </body>
</html>
