<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Contact Us | BuildaPC</title>

    <link rel="stylesheet" href="/user/css/home.css" />
    <link rel="stylesheet" href="/user/css/contact.css" />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
    />
  </head>
  <body>
    <%- include('../../views/partials/user/header') %>

    <main class="contact-page">
      <section class="contact-heading">
        <h1>Contact Us</h1>
        <p>Have a question or need assistance? We're here to help.</p>
      </section>

      <section class="contact-container">
        <div class="contact-info">
          <h2>Get in Touch</h2>
          <p class="contact-description">
            Whether you need help choosing PC components, tracking an order, or resolving an issue,
            feel free to contact us.
          </p>

          <div class="contact-info-item">
            <div class="contact-icon">
              <i class="fa-solid fa-envelope"></i>
            </div>
            <div>
              <h4>Email Us</h4>
              <p>support@buildapc.com</p>
            </div>
          </div>
        </div>

        <div class="contact-form-wrapper">
          <h2>Send Us a Message</h2>
          <% if (success) { %>
          <div class="contact-success">Your message has been sent successfully!</div>
          <% } %>
          <% if (error) { %>
          <div class="contact-error">
            <% if (error === 'required') { %> All fields are required. <% } else if (error ===
            'invalidEmail') { %> Please enter a valid email address. <% } else if (error ===
            'emailFailed') { %> Unable to send your message. Please try again. <% } else { %>
            Something went wrong. Please try again. <% } %>
          </div>
          <% } %>
          <form action="/contact" method="POST" class="contact-form">
            <div class="form-group">
              <label for="name">Full Name</label>
              <input type="text" id="name" name="name" placeholder="Enter your name" required />
            </div>
            <div class="form-group">
              <label for="email">Email Address</label>
              <input type="email" id="email" name="email" placeholder="Enter your email" required />
            </div>
            <div class="form-group">
              <label for="subject">Subject</label>
              <input
                type="text"
                id="subject"
                name="subject"
                maxlength="150"
                placeholder="What is this about?"
                required
              />
            </div>
            <div class="form-group">
              <label for="message">Message</label>
              <textarea
                id="message"
                name="message"
                rows="5"
                placeholder="Write your message here..."
                maxlength="3000"
                required
              ></textarea>
            </div>
            <button type="submit" class="contact-submit-btn">Send Message</button>
          </form>
        </div>
      </section>
    </main>
    <%- include('../../views/partials/user/footer') %>
  </body>
</html>
