<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Payment | BuildaPC</title>

    <link rel="stylesheet" href="/user/css/home.css" />
    <link rel="stylesheet" href="/user/css/payment.css" />
  </head>
  <body>
    <%- include('../../views/partials/user/header.ejs') %>
    <main class="payment-page">
      <div class="checkout-progress">
        <div class="progress-step completed">
          <div class="progress-circle">✓</div>
          <span> Order Summary </span>
        </div>

        <div class="progress-line active"></div>
        <!-- Payment -->
        <div class="progress-step active">
          <div class="progress-circle">2</div>
          <span> Payment </span>
        </div>
      </div>

      <div class="payment-container">
        <div class="payment-left">
          <h1 class="payment-title">Select Payment Method</h1>

          <div class="payment-methods">
            <div class="payment-method selected" data-payment-method="cod">
              <div class="payment-method-icon">
                <span class="payment-radio"></span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="6" width="18" height="12" rx="2"></rect>
                  <circle cx="12" cy="12" r="2"></circle>
                </svg>
              </div>
              <div class="payment-method-content">
                <h3>Cash on Delivery</h3>
                <p class="payment-method-subtitle">Pay when your order is delivered</p>
                <div class="payment-method-info">
                  <p>- You can pay via Cash/UPI/Card when your order is delivered</p>
                  <p>- Please keep exact change ready for a smooth delivery experience</p>
                </div>
              </div>
            </div>

            <div class="payment-method" data-payment-method="online">
              <div class="payment-method-content">
                <h3>Online Payment</h3>

                <p class="payment-method-subtitle">Choose your preferred payment gateway</p>

                <div class="payment-gateways">
                  <div
                    class="payment-gateway"
                    data-payment-gateway="razorpay"
                    role="button"
                    tabindex="0"
                    aria-pressed="false"
                  >
                    <span class="gateway-radio"></span>

                    <div class="gateway-logo razorpay-logo">R</div>

                    <div class="gateway-content">
                      <h4>Razorpay</h4>
                      <p>UPI, Cards, Net Banking and more</p>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="payment-method" data-payment-method="wallet">
            <div class="payment-method-icon">
              <span class="payment-radio"></span>
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <rect x="3" y="5" width="18" height="15" rx="2"></rect>
                <path d="M3 9h18"></path>
                <path d="M16 14h2"></path>
              </svg>
            </div>

            <div class="payment-method-content">
              <h3>Wallet</h3>
              <p class="payment-method-subtitle">Pay using your BuildaPC wallet balance</p>

              <p class="wallet-payment-balance">
                Available balance:
                <strong>
                  ₹<%= Number(walletBalance || 0).toLocaleString('en-IN', {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                }) %>
                </strong>
              </p>
            </div>
          </div>
        </div>

        <aside class="payment-summary">
          <h2 class="payment-summary-title">Order Summary</h2>

          <div class="payment-total-row">
            <span
              >Subtotal (<%= totalItems %>
              items)</span
            >
            <span class="payment-total-price">
              ₹<%= Number(subtotal).toLocaleString('en-IN') %>
            </span>
          </div>

          <!-- Shipping -->
          <div class="payment-total-row">
            <span>Shipping Charge</span>
            <span class="shipping-free">Free</span>
          </div>

          <!-- Coupon Discount -->
          <% if (appliedCoupon) { %>
          <div class="payment-total-row">
            <span>Coupon (<%= appliedCoupon.code %>)</span>
            <span class="payment-total-price coupon-discount">
              −₹<%= Number(discount).toLocaleString('en-IN') %>
            </span>
          </div>
          <% } %>

          <div class="summary-divider"></div>

          <!-- Final Total -->
          <div class="payment-total-row">
            <strong>Total Payable</strong>
            <strong class="payment-total-price">
              ₹<%= Number(totalAmount).toLocaleString('en-IN') %>
            </strong>
          </div>

          <!-- Information -->
          <div class="payment-summary-info">
            <div class="summary-info-item">
              <span class="summary-check">✓</span>
              <span>Your order is eligible for free delivery</span>
            </div>

            <div class="summary-info-item">
              <span class="summary-check">✓</span>
              <span>All items in stock and ready to ship</span>
            </div>
          </div>

          <!-- Place Order -->
          <button type="button" id="placeOrderBtn" class="place-order-btn">Place Order</button>

          <!-- Back -->
          <a href="/checkout" class="back-summary-link"> Back to Order Summary </a>
        </aside>
      </div>
    </main>
    <!-- Payment Failure Modal -->
    <div id="paymentFailureModal" class="payment-failure-overlay" hidden>
      <div
        class="payment-failure-modal"
        role="dialog"
        aria-modal="true"
        aria-labelledby="failureTitle"
      >
        <div class="failure-icon">!</div>

        <h2 id="failureTitle">Order Failed</h2>
        <p id="failureMessage">Your payment could not be processed at this time.</p>

        <div class="failure-reasons">
          <p>Possible reasons:</p>
          <ul id="failureReasons"></ul>
        </div>

        <button type="button" id="retryPaymentBtn" class="failure-retry-btn">
          ↻ &nbsp; Try Payment Again
        </button>

        <button type="button" id="differentPaymentBtn" class="failure-secondary-btn">
          Use Different Payment Method
        </button>
        <button type="button" id="returnToCartBtn" class="failure-back-btn">
          ← &nbsp; Return to Cart
        </button>
      </div>
    </div>
    <!-- Footer -->
    <%- include('../../views/partials/user/footer.ejs') %>
    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
    <script src="/user/js/payment.js"></script>
  </body>
</html>
