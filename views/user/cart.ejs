<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Shopping Cart - BuildaPC</title>
    <link rel="stylesheet" href="/user/css/home.css" />
    <link rel="stylesheet" href="/user/css/cart.css" />
  </head>

  <body>
    <%- include('../../views/partials/user/header.ejs') %>
    <main class="cart-page">
      <div class="cart-container">
        <h1 class="cart-page-title">Shopping Cart</h1>
        <% if (items && items.length > 0) { %>
        <div class="cart-layout">
          <section class="cart-items-section">
            <% items.forEach(item => { %>

            <div
              class="cart-item"
              data-id="<%= item._id %>"
              data-price="<%= item.finalPrice ?? (item.variantId ? item.variantId.price : item.productId.basePrice) %>"
              data-original-price="<%= item.originalPrice ?? (item.variantId ? item.variantId.price : item.productId.basePrice) %>"
              data-discount-amount="<%= item.discountAmount ?? 0 %>"
              data-quantity="<%= item.quantity %>"
              data-stock="<%= item.variantId ? item.variantId.stock : item.productId.stockLevel %>"
              data-product-id="<%= item.productId._id %>"
            >
              <div class="cart-product-image">
                <a href="/product/<%= item.productId._id %>">
                  <img src="<%= item.productId.primaryImage %>" alt="<%= item.productId.name %>" />
                </a>
              </div>

              <div class="cart-product-details">
                <h3 class="cart-product-name"><%= item.productId.name %></h3>
                <% if (item.variantId) { %>
                <div class="cart-variant-details">
                  <% item.variantId.attributes.forEach(attribute => { %>
                  <p><%= attribute.name %>: <%= attribute.value %> <% }) %></p>
                </div>
                <% } %>
                <p class="cart-seller">Seller: BuildaPC</p>

                <div class="cart-quantity">
                  <button type="button" class="quantity-btn quantity-minus">−</button>

                  <span class="quantity-value"> <%= item.quantity %> </span>

                  <button type="button" class="quantity-btn quantity-plus">+</button>
                </div>
              </div>

              <div class="cart-item-right">
                <div class="cart-item-actions">
                  <button type="button" class="cart-wishlist-btn" title="Add to wishlist">
                    Move to Wishlist
                  </button>
                  <button type="button" class="cart-remove-btn" title="Remove from cart">
                    Remove
                  </button>
                </div>
                <div class="cart-item-price">
                  <% if (Number(item.discountAmount) > 0) { %>
                  <span class="cart-original-price">
                    ₹<%= Number(item.originalPrice).toLocaleString('en-IN') %>
                  </span>

                  <span class="cart-discounted-price">
                    ₹<%= Number(item.finalPrice).toLocaleString('en-IN') %>
                  </span>

                  <span class="cart-offer-badge">
                    <%= Number(item.discountPercentage) %>% OFF
                  </span>
                  <% } else { %>
                  <span class="cart-regular-price">
                    ₹<%= Number( item.originalPrice ?? (item.variantId ? item.variantId.price :
                    item.productId.basePrice) ).toLocaleString('en-IN') %>
                  </span>
                  <% } %>
                  <div class="cart-line-total">
                    Item total: ₹<%= Number( item.lineTotal ?? (Number(item.finalPrice ??
                    item.originalPrice ?? (item.variantId ? item.variantId.price :
                    item.productId.basePrice)) * item.quantity) ).toLocaleString('en-IN') %>
                  </div>
                </div>
              </div>
            </div>
            <% }) %>
          </section>

          <aside class="order-summary">
            <h2>Order Summary</h2>
            <div class="summary-row">
              <span>
                Subtotal
                <span class="summary-item-count" id="cartItemCount">
                  ( <%= items.reduce((total,item)=>total+item.quantity,0) %> items )
                </span>
              </span>
              <span id="cartSubtotal"> ₹0 </span>
            </div>
            <div class="saving-message" id="cartSavings" hidden></div>
            <div class="summary-row shipping-row">
              <span> Shipping Charge </span>
              <span class="shipping-free"> Free </span>
            </div>
            <div class="summary-divider"></div>
            <div class="summary-total">
              <span> Total </span>
              <span id="cartTotal"> ₹0 </span>
            </div>

            <button type="button" class="checkout-btn" id="proceedToCheckoutBtn">
              Proceed to Checkout
            </button>

            <div class="delivery-info"></div>
          </aside>
        </div>
        <% } else { %>

        <div class="empty-cart">
          <h2>Your Cart is Empty</h2>
          <p>Add products to your cart to see them here.</p>
          <a href="/products" class="continue-shopping-btn"> Continue Shopping </a>
        </div>
        <% } %>
      </div>
    </main>

    <%- include('../../views/partials/user/footer.ejs') %>

    <script src="/user/js/cart.js"></script>
  </body>
</html>
