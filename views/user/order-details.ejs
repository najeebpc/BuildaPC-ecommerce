<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Order Details</title>

    <link rel="stylesheet" href="/user/css/home.css" />
    <link rel="stylesheet" href="/user/css/accounts.css" />
    <link rel="stylesheet" href="/user/css/orders.css" />
    <link rel="stylesheet" href="/user/css/order-details.css" />
  </head>
  <body>
    <%- include('../../views/partials/user/header.ejs') %>
    <main class="account-page">
      <div class="account-layout">
        <%- include( '../../views/partials/user/accounts-sidebar.ejs', { active: 'orders' } ) %>
        <section class="account-content">
          <div class="order-header-card">
            <div class="order-header-left">
              <h1>
                Order #
                <%= order.orderId %>
              </h1>
              <p>
                Placed on
                <span>
                  <%= new Date(order.createdAt)
                        .toLocaleDateString('en-IN', {
                            day: '2-digit',
                            month: 'short',
                            year: 'numeric'
                        }) %>
                </span>
              </p>
            </div>
            <div class="order-header-actions">
              <% if (order.orderStatus==='delivered'){ %>
              <a href="/account/orders/<%=order.orderId%>/invoice" class="download-invoice-btn">
                <span class="print-icon">▣</span>
                Print Invoice
              </a>
              <%} %>
              <% if (
                ['pending']
                    .includes(order.orderStatus)
            ) { %>
              <button type="button" class="cancel-order-btn" data-order-id="<%= order.orderId %>">
                Cancel order
              </button>
              <% } %>
            </div>
          </div>
          <!-- Order Summary -->
          <div class="order-summary-section">
            <h2 class="order-section-title">Order Summary</h2>
            <div class="order-product-list">
              <% order.items.forEach(item => { %>
              <div class="order-product-item">
                <div class="order-product-image">
                  <img src="<%= item.productImage %>" alt="<%= item.productName %>" />
                </div>
                <div class="order-product-info">
                  <h3>
                    <a href="/product/<%=item.productId%>" class="order-product-link">
                      <%= item.productName %>
                    </a>
                  </h3>
                  <% if ( item.variantAttributes && item.variantAttributes.length > 0 ) { %>
                  <div class="order-variant-details">
                    <% item.variantAttributes.forEach(attribute => { %>
                    <span>
                      <%= attribute.name %>:
                      <%= attribute.value %>
                    </span>
                    <% }) %>
                  </div>
                  <% } %>
                  <p class="order-product-quantity">Qty: <%= item.quantity %></p>
                </div>

                <div class="order-product-price">
                  <% const originalPrice = Number( item.originalPrice ?? item.price ); %> <% const
                  discountAmount = Number(item.discountAmount ?? 0); %> <% const finalPrice =
                  Number(item.price); %> <% if (discountAmount > 0) { %>
                  <span class="order-original-price">
                    ₹<%= originalPrice.toLocaleString('en-IN') %>
                  </span>

                  <span class="order-discounted-price">
                    ₹<%= finalPrice.toLocaleString('en-IN') %>
                  </span>

                  <span class="order-offer-badge">
                    <%= Number( item.discountPercentage ?? Math.round((discountAmount /
                    originalPrice) * 100) ) %>% OFF
                  </span>
                  <% } else { %>
                  <span class="order-regular-price">
                    ₹<%= finalPrice.toLocaleString('en-IN') %>
                  </span>
                  <% } %>

                  <span class="order-product-line-total">
                    Qty <%= item.quantity %> · ₹<%= Number( finalPrice * item.quantity
                    ).toLocaleString('en-IN') %>
                  </span>

                  <% if (order.orderStatus === 'cancelled') { %>
                  <span class="item-cancelled-status">Order Cancelled</span>
                  <% } else if (item.itemStatus === 'cancelled') { %>
                  <span class="item-cancelled-status">Item Cancelled</span>
                  <% } else if (item.itemStatus === 'returned') { %>
                  <span class="item-cancelled-status">Item Returned</span>
                  <% } else if (item.returnStatus === 'requested') { %>
                  <span class="item-return-status requested">Return Requested</span>
                  <% } else if (item.returnStatus === 'approved') { %>
                  <span class="item-return-status approved">Return Approved</span>
                  <% } else if (item.returnStatus === 'rejected') { %>
                  <span class="item-return-status rejected">Return Rejected</span>
                  <% } else if (item.returnStatus === 'received') { %>
                  <span class="item-return-status received">Return Received</span>
                  <% } else if (['pending'].includes(order.orderStatus)) { %>
                  <button
                    type="button"
                    class="cancel-item-btn"
                    data-order-id="<%= order.orderId %>"
                    data-item-id="<%= item._id %>"
                    data-product-name="<%= item.productName %>"
                  >
                    Cancel Item
                  </button>
                  <% } else if(order.orderStatus==='delivered'){ %>
                  <button
                    type="button"
                    class="return-item-btn"
                    data-order-id="<%= order.orderId %>"
                    data-item-id="<%= item._id %>"
                    data-product-name="<%= item.productName %>"
                  >
                    Return Item
                  </button>
                  <% } %>
                </div>
              </div>
              <% }) %>
            </div>
          </div>
          <!-- Bottom Information -->
          <div class="order-bottom-section">
            <!-- Shipping Information -->
            <div class="order-info-section">
              <h2 class="order-info-title">
                <span class="info-icon"> ♧ </span>
                Shipping Information
              </h2>
              <div class="shipping-info-box">
                <strong>
                  <%= order.shippingAddress.fullName %>
                </strong>
                <p>
                  <%= order.shippingAddress.addressLine1 %> <% if
                  (order.shippingAddress.addressLine2) { %> , <%= order.shippingAddress.addressLine2
                  %> <% } %>
                </p>
                <p>
                  <%= order.shippingAddress.city %> , <%= order.shippingAddress.state %> - <%=
                  order.shippingAddress.pincode %>
                </p>
                <p class="shipping-phone">Phone: <%= order.shippingAddress.phone %></p>
              </div>
            </div>
            <!-- Billing Information -->
            <div class="order-info-section">
              <h2 class="order-info-title">
                <span class="info-icon"> ▣ </span>
                Billing Information
              </h2>

              <div class="billing-info-box">
                <% const totalOfferDiscount = order.items.reduce((total, item) => { if
                (item.itemStatus === 'cancelled') { return total; } const discount =
                Number(item.discountAmount ?? 0); const quantity = Number(item.quantity ?? 0);
                return total + (discount * quantity); }, 0); const originalSubtotal =
                Number(order.subtotal ?? 0) + totalOfferDiscount;%>

                <div class="billing-row">
                  <span>Subtotal </span>
                  <span> ₹<%=originalSubtotal.toLocaleString('en-IN')%> </span>
                </div>
                <% if (totalOfferDiscount > 0) { %>
                <div class="billing-row coupon-savings-row">
                  <span>Offer Savings</span>
                  <span> −₹<%= totalOfferDiscount.toLocaleString('en-IN') %> </span>
                </div>
                <% } %>
                <% if (totalOfferDiscount > 0) { %>
                <div class="billing-row">
                  <span>Subtotal After Offers</span>
                  <span> ₹<%= Number(order.subtotal || 0).toLocaleString('en-IN') %> </span>
                </div>
                <% } %>
                <% if (Number(order.couponDiscount) > 0) { %>
                <div class="billing-row coupon-savings-row">
                  <span>Coupon applied (<%= order.couponCode %>)</span>
                  <span> −₹<%= Number(order.couponDiscount).toLocaleString('en-IN') %> </span>
                </div>
                <% } %>

                <div class="billing-row">
                  <span>Shipping</span>
                  <span class="free-shipping">Free</span>
                </div>

                <div class="billing-row">
                  <span>Inclusive of all taxes</span>
                  <span></span>
                </div>

                <div class="payment-method-row">
                  <span>Payment Method:</span>
                  <span>
                    <%= order.paymentMethod === 'cod'
                ? 'Cash on Delivery'
                : order.paymentMethod === 'wallet'
                    ? 'Wallet'
                    : 'Online Payment' %>
                  </span>
                </div>

                <div class="billing-total-row">
                  <strong>Total Paid / Payable</strong>
                  <strong> ₹<%= Number(order.totalAmount).toLocaleString('en-IN') %> </strong>
                </div>
              </div>
            </div>
          </div>
        </section>
      </div>
      <div class="cancel-order-modal" id="cancelOrderModal">
        <div class="cancel-order-modal-overlay"></div>
        <div class="cancel-order-modal-content">
          <!-- Header -->
          <div class="cancel-order-modal-header">
            <h3>Cancel Order</h3>
            <button type="button" class="cancel-modal-close" id="cancelModalClose">×</button>
          </div>
          <!-- Body -->
          <div class="cancel-order-modal-body">
            <p class="cancel-confirmation-text">Are you sure you want to cancel this order?</p>
            <label for="cancellationReason" class="cancellation-reason-label">
              Reason
              <span>(Optional)</span>
            </label>
            <textarea
              id="cancellationReason"
              class="cancellation-reason-input"
              placeholder="Enter cancellation reason..."
              rows="3"
            ></textarea>
          </div>
          <!-- Footer -->
          <div class="cancel-order-modal-footer">
            <button type="button" class="cancel-modal-btn" id="cancelModalCancel">Cancel</button>
            <button type="button" class="confirm-cancel-btn" id="confirmCancelOrder">
              Confirm Cancellation
            </button>
          </div>
        </div>
      </div>
      <!-- order item cancellation modal -->
      <div class="cancel-order-modal" id="cancelItemModal">
        <div class="cancel-order-modal-overlay"></div>

        <div class="cancel-order-modal-content">
          <div class="cancel-order-modal-header">
            <h3>Cancel Item</h3>
            <button type="button" class="cancel-modal-close" id="cancelItemModalClose">×</button>
          </div>

          <div class="cancel-order-modal-body">
            <p id="cancelItemConfirmation">Are you sure you want to cancel this item?</p>
            <p id="couponWarning" class="coupon-warning" hidden></p>
            <label for="itemCancellationReason" class="cancellation-reason-label">
              Reason <span>(Optional)</span>
            </label>

            <textarea
              id="itemCancellationReason"
              class="cancellation-reason-input"
              placeholder="Enter cancellation reason..."
              rows="3"
            ></textarea>
          </div>

          <div class="cancel-order-modal-footer">
            <button type="button" class="cancel-modal-btn" id="cancelItemModalCancel">
              Keep Item
            </button>

            <button type="button" class="confirm-cancel-btn" id="confirmCancelItem">
              Confirm Cancellation
            </button>
          </div>
        </div>
      </div>
      <!-- =========================================
     RETURN ORDER MODAL
========================================= -->

      <div class="return-order-modal" id="returnOrderModal">
        <div class="return-order-modal-overlay"></div>

        <div class="return-order-modal-content">
          <div class="return-order-modal-header">
            <h3>Return Item</h3>

            <button type="button" class="return-modal-close" id="returnModalClose">×</button>
          </div>

          <div class="return-order-modal-body">
            <p class="return-confirmation-text">Are you sure you want to return this order?</p>

            <label for="returnReason" class="return-reason-label">
              Return Reason
              <span>*</span>
            </label>

            <textarea
              id="returnReason"
              class="return-reason-input"
              placeholder="Enter your return reason..."
              rows="3"
            ></textarea>

            <span id="returnReasonError" class="return-reason-error"></span>
          </div>

          <div class="return-order-modal-footer">
            <button type="button" class="return-modal-btn" id="returnModalCancel">Cancel</button>
            <button type="button" class="confirm-return-btn" id="confirmReturnOrder">
              Confirm Return
            </button>
          </div>
        </div>
      </div>
    </main>
    <%- include('../../views/partials/user/footer.ejs') %>
    <script src="/user/js/order-details.js"></script>
  </body>
</html>
