<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>My Orders</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/user/css/home.css" />
    <link rel="stylesheet" href="/user/css/accounts.css" />
    <link rel="stylesheet" href="/user/css/orders.css" />
  </head>

  <body>
    <%- include('../../views/partials/user/header.ejs') %>
    <main class="account-page">
      <div class="account-layout">
        <%- include( '../../views/partials/user/accounts-sidebar.ejs', { active: 'orders' } ) %>

        <section class="account-content">
          <div class="orders-page-header">
            <h2 class="account-page-title">My Orders</h2>
          </div>

          <% if (orders && orders.length > 0) { %>
          <div class="orders-list">
            <% orders.forEach(order => { %>
            <div class="order-card" data-order-id="<%= order.orderId %>">
              <div class="order-card-header">
                <div class="order-header-left">
                  <div class="order-id-row">
                    <span class="order-label"> Order # </span>
                    <strong class="order-id"> <%= order.orderId %> </strong>
                  </div>
                  <div class="order-date-row">
                    <span> Placed on </span>
                    <span>
                      <%= new Date(
                                                    order.createdAt
                                                ).toLocaleDateString(
                                                    'en-IN',
                                                    {
                                                        month: 'short',
                                                        day: 'numeric',
                                                        year: 'numeric'
                                                    }
                                                ) %>
                    </span>
                  </div>
                </div>
                <div class="order-header-right">
                  ₹<%= Number( order.totalAmount ).toLocaleString('en-IN') %>
                </div>
              </div>

              <div class="order-card-items">
                <% order.items.forEach(item => { %>
                <div class="order-item">
                  <div class="order-item-image">
                    <img src="<%= item.productImage %>" alt="<%= item.productName %>" />
                  </div>

                  <div class="order-item-details">
                    <h3>
                      <%= item.productName %>
                    </h3>
                    <% if ( item.variantAttributes && item.variantAttributes.length > 0 ) { %>
                    <div class="order-item-variants">
                      <% item.variantAttributes.forEach( attribute => { %>
                      <span>
                        <%= attribute.name %>:
                        <%= attribute.value %>
                      </span>
                      <% }) %>
                    </div>
                    <% } %>
                    <p class="order-item-price">
                      Qty: <%= item.quantity %> × ₹<%= Number( item.price ).toLocaleString( 'en-IN'
                      ) %>
                    </p>
                  </div>
                </div>
                <% }) %>
              </div>

              <div class="order-card-footer">
                <div class="order-status-wrapper">
                  <span class="order-status-label"> Status </span>
                  <span class="order-status status-<%= order.orderStatus.replace(/\s+/g, '-') %>">
                    <%= order.orderStatus .replace(/\b\w/g, letter => letter.toUpperCase() ) %>
                  </span>
                </div>

                <div class="order-actions">
                  <a href="/account/orders/<%= order.orderId %>" class="view-order-btn">
                    View Details
                  </a>
                  <% if (
                                            order.orderStatus === 'pending'
                                        ) { %>
                  <button
                    type="button"
                    class="cancel-order-btn"
                    data-order-id="<%= order.orderId %>"
                  >
                    Cancel Order
                  </button>
                  <% } %>
                </div>
              </div>
            </div>
            <% }) %>
          </div>
          <% } else { %>

          <div class="account-card orders-empty">
            <div class="orders-empty-icon">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M6 2h12"></path>

                <path d="M6 2v4"></path>

                <path d="M18 2v4"></path>

                <path d="M4 6h16"></path>

                <path d="M5 6v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V6"></path>

                <path d="M9 10h6"></path>

                <path d="M9 14h6"></path>
              </svg>
            </div>
            <h3>No Orders Yet</h3>
            <p>You haven't placed any orders yet.</p>
            <a href="/products" class="orders-shop-btn"> Continue Shopping </a>
          </div>
          <% } %>
        </section>
      </div>
    </main>

    <div class="cancel-order-modal" id="cancelOrderModal">
      <div class="cancel-order-modal-overlay"></div>
      <div class="cancel-order-modal-content">
        <div class="cancel-order-modal-header">
          <h3>Cancel Order</h3>
          <button type="button" class="cancel-modal-close" id="cancelModalClose">×</button>
        </div>

        <div class="cancel-order-modal-body">
          <p class="cancel-confirmation-text">Are you sure you want to cancel this order?</p>
          <label for="cancellationReason" class="cancellation-reason-label">
            Reason
            <span>(Optional)</span>
          </label>
          <textarea
            id="cancellationReason"
            class="cancellation-reason-input"
            placeholder="Enter cancellation reason..."
            rows="3"
          ></textarea>
        </div>

        <div class="cancel-order-modal-footer">
          <button type="button" class="cancel-modal-btn" id="cancelModalCancel">Cancel</button>
          <button type="button" class="confirm-cancel-btn" id="confirmCancelOrder">
            Confirm Cancellation
          </button>
        </div>
      </div>
    </div>

    <div class="return-order-modal" id="returnOrderModal">
      <div class="return-order-modal-overlay"></div>

      <div class="return-order-modal-content">
        <div class="return-order-modal-header">
          <h3>Return Order</h3>

          <button type="button" class="return-modal-close" id="returnModalClose">×</button>
        </div>

        <div class="return-order-modal-body">
          <p class="return-confirmation-text">Are you sure you want to return this order?</p>

          <label for="returnReason" class="return-reason-label">
            Return Reason
            <span>*</span>
          </label>

          <textarea
            id="returnReason"
            class="return-reason-input"
            placeholder="Enter your return reason..."
            rows="3"
          ></textarea>

          <span id="returnReasonError" class="return-reason-error"></span>
        </div>

        <div class="return-order-modal-footer">
          <button type="button" class="return-modal-btn" id="returnModalCancel">Cancel</button>

          <button type="button" class="confirm-return-btn" id="confirmReturnOrder">
            Confirm Return
          </button>
        </div>
      </div>
    </div>

    <%- include('../../views/partials/user/footer.ejs') %>
    <script src="/user/js/orders.js"></script>
  </body>
</html>
