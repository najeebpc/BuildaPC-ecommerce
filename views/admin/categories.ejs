<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Category Management</title>

    <link rel="stylesheet" href="/admin/css/admin-base.css" />
    <link rel="stylesheet" href="/admin/css/categories.css" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    />
  </head>

  <body>
    <div class="admin-wrapper">
      <%- include("../partials/admin/sidebar",{active:'categories'}) %>
      <div class="admin-content">
        <%- include('../partials/admin/topbar') %>
        <div class="top-bar">
          <div>
            <h1 class="page-title">Category Management</h1>

            <p class="page-subtitle">Organize your product categories</p>
          </div>

          <button type="button" class="add-category-btn" onclick="openAddCategoryModal()">
            <span class="plus-icon">+</span>

            Add New Category
          </button>
        </div>

        <div id="categoryMessage" class="category-message"></div>
        <div class="category-card">
          <div class="category-search">
            <form method="GET" action="/admin/categories" class="search-form">
              <input
                type="text"
                name="search"
                placeholder="Search categories by name..."
                value="<%= search || '' %>"
              />
              <button type="submit" class="search-btn">Search</button>
              <% if (search) { %>
              <a href="/admin/categories" class="clear-search"> Cancel </a>
              <% } %>
            </form>
          </div>
          <table class="category-table">
            <thead>
              <tr>
                <th>Category Name</th>
                <th>Product Count</th>
                <th>Variant Attributes</th>
                <th>List / Unlist</th>
                <th>Actions</th>
              </tr>
            </thead>

            <tbody>
              <% if(categories.length ===0){%>
              <tr>
                <td colspan="5" class="empty-row">No categories found</td>
              </tr>
              <% } %>
              <% categories.forEach(category =>{%>
              <tr>
                <td>
                  <%=  category.name%>
                </td>
                <td>
                  <%= category.productCount %>
                </td>
                <td>
                  <% if(category.variantAttributes&& category.variantAttributes.length>0){%>
                  <div class="attribute-list">
                    <% category.variantAttributes.forEach(attribute =>{%>
                    <span class="attribute-tag"><%= attribute %></span>
                    <% }) %>
                  </div>
                  <% } %>
                </td>
                <td>
                  <label class="toggle">
                    <% if (category.isListed) { %>
                    <input
                      type="checkbox"
                      class="category-status-toggle"
                      data-category-id="<%= category._id %>"
                      checked
                    />
                    <% } else { %>
                    <input
                      type="checkbox"
                      class="category-status-toggle"
                      data-category-id="<%= category._id %>"
                    />
                    <% } %>
                    <span class="toggle-slider"></span>
                  </label>
                </td>
                <td>
                  <div class="action-links">
                    <a
                      href="#"
                      class="edit-link"
                      data-category="<%= JSON.stringify(category)%>"
                      onclick="
                        editCategory(this);
                        return false;
                      "
                      >Edit</a
                    >
                    <a
                      href=""
                      class="delete-link"
                      onclick="
                        openDeleteModal('<%= category._id %>');
                        return false;
                      "
                    >
                      Delete
                    </a>
                  </div>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
          <div class="pagination">
            <% for (let i = 1; i <= totalPages; i++) { %>
            <a
              href="/admin/categories?page=<%= i %>&search=<%= search || '' %>"
              class="<%= currentPage === i ? 'active' : '' %>"
            >
              <%= i %>
            </a>
            <% } %>
          </div>
        </div>
      </div>
    </div>

    <div class="category-modal-overlay" id="categoryModal">
      <div class="category-modal">
        <div class="category-modal-header">
          <div>
            <h2 id="modalTitle">Add Category</h2>
            <p id="modalSubtitle">Create a new product category</p>
          </div>
          <button type="button" class="category-modal-close" onclick="closeCategoryModal()">
            ×
          </button>
        </div>
        <div class="category-modal-body">
          <div class="form-group">
            <label for="categoryName">
              Category Name
              <span>*</span>
            </label>
            <input
              type="text"
              id="categoryName"
              class="category-input"
              placeholder="Enter category name"
            />
            <p id="categoryNameError" class="field-error"></p>
          </div>
          <div class="form-group category-status-group">
            <label> Category Status </label>
            <div class="status-toggle-row">
              <label class="modal-toggle">
                <input type="checkbox" id="categoryStatus" checked />
                <span class="modal-toggle-slider"></span>
              </label>
              <span id="statusText"> Listed (Visible to customers) </span>
            </div>
          </div>
          <div class="modal-divider"></div>
          <div class="variant-section">
            <h3>Variant Attributes Definition</h3>
            <p class="variant-description">
              Define the unique characteristics that differentiate variants in this category
            </p>
            <label class="variant-label"> Variant Attributes </label>
            <div class="attributes-container" id="attributesContainer"></div>
            <div class="attribute-input-wrapper">
              <input
                type="text"
                id="attributeInput"
                placeholder="Type an attribute and press Enter (e.g., Color, Speed, Capacity)"
              />
              <button type="button" class="add-attribute-btn" onclick="addAttribute()">+</button>
              <p id="categoryAttributeError" class="field-error"></p>
            </div>
            <p class="attribute-help">
              Press
              <span>Enter</span>
              to add each attribute
            </p>
          </div>
        </div>
        <div class="category-modal-footer">
          <button type="button" class="modal-cancel-btn" onclick="closeCategoryModal()">
            Cancel
          </button>
          <button type="button" class="modal-save-btn" id="modalSaveBtn" onclick="saveCategory()">
            Create Category
          </button>
        </div>
      </div>
    </div>
    <div class="category-delete-modal-overlay" id="deleteCategoryModal">
      <div class="category-delete-modal-box">
        <div class="category-delete-modal-header">
          <h3>Delete Category</h3>
          <button
            type="button"
            class="category-delete-modal-close"
            id="closeCategoryDeleteModal"
            onclick="closeDeleteModal()"
          >
            ×
          </button>
        </div>
        <div class="category-delete-modal-body">
          <div class="category-delete-warning-icon">⚠️</div>
          <p id="categoryDeleteModalText">Are you sure you want to delete this category?</p>
        </div>
        <div class="category-delete-modal-footer">
          <button
            type="button"
            class="category-delete-cancel-btn"
            id="cancelCategoryDeleteBtn"
            onclick="closeDeleteModal()"
          >
            Cancel
          </button>
          <button type="button" class="category-delete-confirm-btn" id="confirmCategoryDeleteBtn">
            Delete Category
          </button>
        </div>
      </div>
    </div>
    <script src="/admin/js/categories.js"></script>
  </body>
</html>
