<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>BuildaPC Admin - Forgot Password</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/admin/css/auth.css">
</head>
<body>

  <div class="admin-auth-page">
    <div class="admin-auth-card">

      <div class="admin-auth-header forgot-header">
        <div class="admin-logo">BuildaPC</div>

        <h1 class="admin-heading">Forgot Password</h1>

        <p class="admin-subtext">
          Enter your admin email and we'll send you a verification code.
        </p>
      </div>

      <form class="admin-auth-form"
            action="/admin/forgot-password"
            method="POST">

        <div class="admin-form-group">
          <label for="email">Admin Email</label>

          <input
            type="email"
            id="email"
            name="email"
            placeholder="Enter your admin email"
            value="<%= formData?.email || '' %>"
            required
          >

          <p class="error-text" id="errorText">
            <%= message || '' %>
          </p>
        </div>

        <button type="submit" class="admin-btn-primary" id="sendBtn">
          Send Verification Code
        </button>

      </form>

      <div class="admin-auth-footer">
        Back to <a href="/admin/login">Login</a>
      </div>

    </div>
  </div>
<script>
    const email = document.getElementById('email');
    const errorText = document.getElementById('errorText')
    email.addEventListener('input',()=>{
        errorText.textContent='';
    })
    const forgotPasswordForm = document.querySelector('.admin-auth-form');
    const sendBtn = document.getElementById('sendBtn');
    forgotPasswordForm.addEventListener('submit',()=>{
        if(sendBtn.disabled){
            return;
        }
        sendBtn.disabled= true;
        sendBtn.textContent='Sending...';
    });
</script>
</body>
</html>