<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>My Addresses</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    <link rel="stylesheet" href="/user/css/home.css" />
    <link rel="stylesheet" href="/user/css/accounts.css" />
    <link rel="stylesheet" href="/user/css/address.css" />
  </head>

  <body>
    <%- include('../../views/partials/user/header.ejs') %>

    <main class="account-page">
      <div class="account-layout">
        <%- include('../../views/partials/user/accounts-sidebar.ejs', { active: 'address' }) %>

        <section class="account-content">
          <div class="address-page-title-row">
            <h2 class="account-page-title">My Addresses</h2>
            <button class="btn-primary" id="addBtn">+ Add New Address</button>
          </div>
          <div id="addressMessage" class="address-message"></div>
          <div class="account-card" id="addressForm" style="display: none">
            <h4 id="formTitle">Add New Address</h4>

            <form action="/account/address" method="POST" id="addressFormElement">
              <div class="row-2">
                <div class="form-group">
                  <label for="fullName"> Full Name </label>
                  <input type="text" id="fullName" name="fullName" placeholder="Full Name" />
                  <p class="error-text" id="fullNameError"></p>
                </div>
                <div class="form-group">
                  <label for="phone"> Phone Number </label>
                  <input type="text" id="phone" name="phone" placeholder="Phone Number" />
                  <p class="error-text" id="phoneError"></p>
                </div>
              </div>
              <div class="form-group">
                <label for="addressLine1"> Address </label>
                <input
                  type="text"
                  id="addressLine1"
                  name="addressLine1"
                  placeholder="House No., Building Name"
                />
                <p class="error-text" id="addressLine1Error"></p>
              </div>
              <div class="form-group">
                <label for="addressLine2"> Area / Road </label>
                <input
                  type="text"
                  id="addressLine2"
                  name="addressLine2"
                  placeholder="Road name, Area, Colony"
                />

                <p class="error-text" id="addressLine2Error"></p>
              </div>
              <div class="row-2">
                <div class="form-group">
                  <label for="city"> City </label>
                  <input type="text" id="city" name="city" placeholder="City" />
                  <p class="error-text" id="cityError"></p>
                </div>
                <div class="form-group">
                  <label for="state"> State </label>
                  <select id="state" name="state">
                    <option value="">Select State</option>
                    <option value="Kerala">Kerala</option>
                    <option value="Karnataka">Karnataka</option>
                  </select>
                  <p class="error-text" id="stateError"></p>
                </div>
              </div>
              <div class="form-group">
                <label for="pincode"> Pincode </label>
                <input
                  type="text"
                  id="pincode"
                  name="pincode"
                  placeholder="Pincode"
                  maxlength="6"
                />
                <p class="error-text" id="pincodeError"></p>
              </div>
              <div class="form-actions">
                <button type="submit" class="btn-primary" id="saveBtn">Save</button>
                <button type="button" class="btn-outline" id="cancelBtn">Cancel</button>
              </div>
            </form>
          </div>

          <% if (addresses && addresses.length > 0) { %>

          <div id="addressList">
            <% addresses.forEach(address => { %>
            <div class="account-card address-card" data-id="<%=address._id%>">
              <div class="address-left">
                <div class="address-top">
                  <strong> <%= address.fullName %> </strong>
                  <% if (address.isDefault) { %>
                  <span class="default-badge"> Default </span>
                  <% } %>
                </div>
                <p>
                  <%= address.addressLine1 %><br />
                  <% if (address.addressLine2) { %>
                  <%= address.addressLine2 %><br />
                  <% } %>
                  <%= address.city %>,
                  <%= address.state %>
                  -
                  <%= address.pincode %>
                </p>
                <small>
                  Phone:
                  <%= address.phone %>
                </small>
              </div>
              <div class="address-actions">
                <%if(!address.isDefault){%>
                <span type="button" class="set-default" data-id="<%=address._id%>"
                  >Set as Default</span
                >
                <%}%>
                <span class="edit" data-id="<%= address._id %>" title="Edit address"> ✏️ </span>
                <span class="delete" data-id="<%= address._id %>" title="Delete address"> 🗑 </span>
              </div>
            </div>
            <% }) %>
          </div>
          <% } else { %>

          <div class="account-card address-empty" id="emptyAddress">
            <h4>No addresses yet</h4>
            <p>Add an address to make your checkout faster and easier.</p>
          </div>
          <% } %>

          <div class="address-modal-overlay" id="deleteAddressModal">
            <div class="address-modal-box">
              <div class="address-modal-header">
                <h3 id="addressModalTitle">Delete Address</h3>
                <button type="button" class="address-modal-close" id="closeAddressModal">×</button>
              </div>
              <div class="address-modal-body">
                <div class="address-warning-icon">⚠️</div>
                <p id="addressModalText">Are you sure you want to delete this address?</p>
              </div>
              <div class="address-modal-footer">
                <button type="button" class="address-cancel-btn" id="cancelDeleteBtn">
                  Cancel
                </button>
                <button type="button" class="address-confirm-btn" id="confirmDeleteBtn">
                  Delete Address
                </button>
              </div>
            </div>
          </div>
        </section>
      </div>
    </main>

    <%- include('../../views/partials/user/footer.ejs') %>

    <script src="/user/js/address.js"></script>
  </body>
</html>
