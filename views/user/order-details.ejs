<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Order Details</title>

    <link rel="stylesheet" href="/user/css/home.css">
    <link rel="stylesheet" href="/user/css/accounts.css">
    <link rel="stylesheet" href="/user/css/orders.css">
    <link rel="stylesheet" href="/user/css/order-details.css">
</head>
<body>
<%- include('../../views/partials/user/header.ejs') %>
<main class="account-page">
    <div class="account-layout">
       <%- include(
                '../../views/partials/user/accounts-sidebar.ejs',
                { active: 'orders' }
            ) %>
        <section class="account-content">
    <!-- Order Header -->
    <div class="order-header-card">
        <div class="order-header-left">
            <h1>
                Order # <%= order.orderId %>
            </h1>
            <p>
                Placed on
                <span>
                    <%= new Date(order.createdAt)
                        .toLocaleDateString('en-IN', {
                            day: '2-digit',
                            month: 'short',
                            year: 'numeric'
                        }) %>
                </span>
            </p>
        </div>
        <div class="order-header-actions">
            <% if (order.orderStatus==='delivered'){ %>
            <a
            
                href="/account/orders/<%=order.orderId%>/invoice"
                class="download-invoice-btn"
            >
                <span class="print-icon">▣</span>
                Print Invoice
            </a>
            <%} %>
            <% if (
                ['pending']
                    .includes(order.orderStatus)
            ) { %>
                <button
                    type="button"
                    class="cancel-order-btn"
                    data-order-id="<%= order.orderId %>"
                >
                    Cancel order
                </button>
            <% } %>
        </div>
    </div>
    <!-- Order Summary -->
    <div class="order-summary-section">
        <h2 class="order-section-title">
            Order Summary
        </h2>
        <div class="order-product-list">
            <% order.items.forEach(item => { %>
                <div class="order-product-item">
                    <div class="order-product-image">
                        <img
                            src="<%= item.productImage %>"
                            alt="<%= item.productName %>"
                        >
                    </div>
                    <div class="order-product-info">
                        <h3>
                            <a href="/product/<%=item.productId%>" class="order-product-link">
                            <%= item.productName %>
                            </a>
                        </h3>
                        <% if (
                            item.variantAttributes &&
                            item.variantAttributes.length > 0
                        ) { %>
                            <div class="order-variant-details">
                                <% item.variantAttributes.forEach(attribute => { %>
                                    <span>
                                        <%= attribute.name %>:
                                        <%= attribute.value %>
                                    </span>
                                <% }) %>
                            </div>
                        <% } %>
                        <p class="order-product-quantity">
                            Qty:
                            <%= item.quantity %>
                        </p>
                    </div>
                    
<div class="order-product-price">
    <% const originalPrice = Number(
        item.originalPrice ?? item.price
    ); %>
    <% const discountAmount = Number(item.discountAmount ?? 0); %>
    <% const finalPrice = Number(item.price); %>

    <% if (discountAmount > 0) { %>
        <span class="order-original-price">
            ₹<%= originalPrice.toLocaleString('en-IN') %>
        </span>

        <span class="order-discounted-price">
            ₹<%= finalPrice.toLocaleString('en-IN') %>
        </span>

        <span class="order-offer-badge">
            <%= Number(
                item.discountPercentage ??
                Math.round((discountAmount / originalPrice) * 100)
            ) %>% OFF
        </span>
    <% } else { %>
        <span class="order-regular-price">
            ₹<%= finalPrice.toLocaleString('en-IN') %>
        </span>
    <% } %>

    <span class="order-product-line-total">
        Qty <%= item.quantity %> · ₹<%= Number(
            finalPrice * item.quantity
        ).toLocaleString('en-IN') %>
    </span>
    
    <% if (order.orderStatus === 'cancelled') { %>
    <span class="item-cancelled-status">Order Cancelled</span>
    <% } else if (item.itemStatus === 'cancelled') { %>
    <span class="item-cancelled-status">Item Cancelled</span>
    <% } else if (item.itemStatus === 'returned') { %>
    <span class="item-cancelled-status">Item Returned</span>
    <% } else if (item.returnStatus === 'requested') { %>
    <span class="item-return-status requested">Return Requested</span>
    <% } else if (item.returnStatus === 'approved') { %>
    <span class="item-return-status approved">Return Approved</span>
    <% } else if (item.returnStatus === 'rejected') { %>
    <span class="item-return-status rejected">Return Rejected</span>
    <% } else if (item.returnStatus === 'received') { %>
    <span class="item-return-status received">Return Received</span>
<% } else if (['pending'].includes(order.orderStatus)) { %>
    <button
        type="button"
        class="cancel-item-btn"
        data-order-id="<%= order.orderId %>"
        data-item-id="<%= item._id %>"
        data-product-name="<%= item.productName %>"
    >Cancel Item</button>
<% } else if(order.orderStatus==='delivered'){ %>
        <button
        type="button"
        class="return-item-btn"
        data-order-id="<%= order.orderId %>"
        data-item-id="<%= item._id %>"
        data-product-name="<%= item.productName %>"
    >Return Item</button>
<% } %>
</div>
  </div>
            <% }) %>
        </div>
    </div>
    <!-- Bottom Information -->
    <div class="order-bottom-section">
        <!-- Shipping Information -->
        <div class="order-info-section">
            <h2 class="order-info-title">
                <span class="info-icon">
                    ♧
                </span>
                Shipping Information
            </h2>
            <div class="shipping-info-box">
                <strong>
                    <%= order.shippingAddress.fullName %>
                </strong>
                <p>
                    <%= order.shippingAddress.addressLine1 %>
                    <% if (order.shippingAddress.addressLine2) { %>
                        ,
                        <%= order.shippingAddress.addressLine2 %>
                    <% } %>
                </p>
                <p>
                    <%= order.shippingAddress.city %>
                    ,
                    <%= order.shippingAddress.state %>
                    -
                    <%= order.shippingAddress.pincode %>
                </p>
                <p class="shipping-phone">
                    Phone:
                    <%= order.shippingAddress.phone %>
                </p>
                <!-- <div class="shipping-method">
                    <span class="shipping-truck">
                        ▣
                    </span>
                    Free Standard Shipping
                </div> -->
            </div>
        </div>
        <!-- Billing Information -->
        <div class="order-info-section">
            <h2 class="order-info-title">
                <span class="info-icon">
                    ▣
                </span>
                Billing Information
            </h2>
       
<div class="billing-info-box">
    <% const totalOfferDiscount = order.items.reduce((total,item)=>{
        if(item.itemStatus==='cancelled'){
            return total;
        }
        return total+(Number(item.discountAmount||0)*Number(item.quantity||0));
    },0);
       const originalSubtotal = Number(order.subtotal||0)+totalOfferDiscount;
    %>
    <div class="billing-row">
        <span>Subtotal </span>
        <span>
            ₹<%=originalSubtotal.toLocaleString('en-IN')%>
        </span>
    </div>
    <% if (totalOfferDiscount > 0) { %>
    <div class="billing-row coupon-savings-row">
        <span>Offer Savings</span>
        <span>
            −₹<%= totalOfferDiscount.toLocaleString('en-IN') %>
        </span>
    </div>
    <% } %>
    <% if (totalOfferDiscount > 0) { %>
    <div class="billing-row">
    <span>Subtotal After Offers</span>
    <span>
        ₹<%= Number(order.subtotal || 0).toLocaleString('en-IN') %>
    </span>
    </div>
    <% } %>
    <% if (Number(order.couponDiscount) > 0) { %>
        <div class="billing-row coupon-savings-row">
            <span>Coupon applied (<%= order.couponCode %>)</span>
            <span>
                −₹<%= Number(order.couponDiscount).toLocaleString('en-IN') %>
            </span>
        </div>
    <% } %>

    <div class="billing-row">
        <span>Shipping</span>
        <span class="free-shipping">Free</span>
    </div>

    <div class="billing-row">
        <span>Inclusive of all taxes</span>
        <span></span>
    </div>

    <div class="payment-method-row">
        <span>Payment Method:</span>
        <span>
            <%= order.paymentMethod === 'cod'
                ? 'Cash on Delivery'
                : order.paymentMethod === 'wallet'
                    ? 'Wallet'
                    : 'Online Payment' %>
        </span>
    </div>

    <div class="billing-total-row">
        <strong>Total Paid / Payable</strong>
        <strong>
            ₹<%= Number(order.totalAmount).toLocaleString('en-IN') %>
        </strong>
    </div>
</div>

        </div>
    </div>
</section>
    </div>
    <div
    class="cancel-order-modal"
    id="cancelOrderModal">
    <div class="cancel-order-modal-overlay"></div>
    <div class="cancel-order-modal-content">
        <!-- Header -->
        <div class="cancel-order-modal-header">
            <h3>
                Cancel Order
            </h3>
            <button
                type="button"
                class="cancel-modal-close"
                id="cancelModalClose"
            >
                ×
            </button>
        </div>
        <!-- Body -->
        <div class="cancel-order-modal-body">
            <p class="cancel-confirmation-text">
                Are you sure you want to cancel this order?
            </p>
            <label
                for="cancellationReason"
                class="cancellation-reason-label"
            >
                Reason
                <span>(Optional)</span>
            </label>
            <textarea
                id="cancellationReason"
                class="cancellation-reason-input"
                placeholder="Enter cancellation reason..."
                rows="3"
            ></textarea>
        </div>
        <!-- Footer -->
        <div class="cancel-order-modal-footer">
            <button
                type="button"
                class="cancel-modal-btn"
                id="cancelModalCancel"
            >
                Cancel
            </button>
            <button
                type="button"
                class="confirm-cancel-btn"
                id="confirmCancelOrder"
            >
                Confirm Cancellation
            </button>
        </div>
    </div>
</div>
<!-- order item cancellation modal -->
<div class="cancel-order-modal" id="cancelItemModal">
    <div class="cancel-order-modal-overlay"></div>

    <div class="cancel-order-modal-content">
        <div class="cancel-order-modal-header">
            <h3>Cancel Item</h3>
            <button
                type="button"
                class="cancel-modal-close"
                id="cancelItemModalClose"
            >×</button>
        </div>

        <div class="cancel-order-modal-body">
            <p id="cancelItemConfirmation">
                Are you sure you want to cancel this item?
            </p>
            <p id="couponWarning" class="coupon-warning" hidden></p>
            <label
                for="itemCancellationReason"
                class="cancellation-reason-label"
            >
                Reason <span>(Optional)</span>
            </label>

            <textarea
                id="itemCancellationReason"
                class="cancellation-reason-input"
                placeholder="Enter cancellation reason..."
                rows="3"
            ></textarea>
        </div>

        <div class="cancel-order-modal-footer">
            <button
                type="button"
                class="cancel-modal-btn"
                id="cancelItemModalCancel"
            >
                Keep Item
            </button>

            <button
                type="button"
                class="confirm-cancel-btn"
                id="confirmCancelItem"
            >
                Confirm Cancellation
            </button>
        </div>
    </div>
</div>
<!-- =========================================
     RETURN ORDER MODAL
========================================= -->

<div
    class="return-order-modal"
    id="returnOrderModal"
>

    <div class="return-order-modal-overlay"></div>

    <div class="return-order-modal-content">

        <div class="return-order-modal-header">

            <h3>
                Return Item
            </h3>

            <button
                type="button"
                class="return-modal-close"
                id="returnModalClose"
            >
                ×
            </button>

        </div>


        <div class="return-order-modal-body">

            <p class="return-confirmation-text">
                Are you sure you want to return this order?
            </p>


            <label
                for="returnReason"
                class="return-reason-label"
            >
                Return Reason
                <span>*</span>
            </label>


            <textarea
                id="returnReason"
                class="return-reason-input"
                placeholder="Enter your return reason..."
                rows="3"
            ></textarea>


            <span
                id="returnReasonError"
                class="return-reason-error"
            ></span>

        </div>


        <div class="return-order-modal-footer">

            <button
                type="button"
                class="return-modal-btn"
                id="returnModalCancel"
            >
                Cancel
            </button>
            <button
                type="button"
                class="confirm-return-btn"
                id="confirmReturnOrder"
            >
                Confirm Return
            </button>
        </div>
    </div>
</main>
<%- include('../../views/partials/user/footer.ejs') %>
<script>
    const cancelOrderModal = document.getElementById('cancelOrderModal');
    const cancelModalClose =  document.getElementById('cancelModalClose');
    const cancelModalCancel = document.getElementById('cancelModalCancel');
    const confirmCancelOrder =document.getElementById('confirmCancelOrder');
    const cancellationReason =document.getElementById('cancellationReason');
    let selectedOrderId = null;

    const cancelOrderButtons =document.querySelectorAll('.cancel-order-btn');
    cancelOrderButtons.forEach(button => {
        button.addEventListener('click', function () {
            selectedOrderId = this.dataset.orderId;
            cancellationReason.value = '';
            cancelOrderModal.classList.add('show');
        });
    });
    function closeCancelModal() {
        cancelOrderModal.classList.remove('show');
        selectedOrderId = null;
        cancellationReason.value = '';
        confirmCancelOrder.disabled = false;
        confirmCancelOrder.textContent =
            'Confirm Cancellation';
    }
    cancelModalClose.addEventListener('click', closeCancelModal);
    cancelModalCancel.addEventListener('click', closeCancelModal);

    document.querySelector('.cancel-order-modal-overlay').addEventListener('click',closeCancelModal);

    confirmCancelOrder.addEventListener(
        'click',
        async function () {
            if (!selectedOrderId) {
                return;
            }
            const reason = cancellationReason.value.trim();
            confirmCancelOrder.disabled = true;
            confirmCancelOrder.textContent = 'Cancelling...';
            try {
                const response =
                    await fetch(
                        `/account/orders/${selectedOrderId}/cancel`,
                        {
                            method: 'PATCH',
                            headers: {
                                'Content-Type':'application/json',
                                'Accept': 'application/json'
                            },
                            body: JSON.stringify({
                                cancellationReason: reason
                            })
                        }
                    );
                const result = await response.json();
                if ( !response.ok ||!result.success ) {

                    showToastMessage(
                        result.message ||
                        'Unable to cancel order','error');
                    confirmCancelOrder.disabled = false;
                    confirmCancelOrder.textContent =  'Confirm Cancellation';
                    return;
                }
                closeCancelModal();
                showToastMessage(  result.message ||'Order cancelled successfully', 'success');
                setTimeout(() => {
                    window.location.reload();
                }, 1000);
            } catch (error) {
                console.log(
                    'Cancel order error:', error );
                showToastMessage('Unable to cancel order', 'error' );
                confirmCancelOrder.disabled =   false;
                confirmCancelOrder.textContent = 'Confirm Cancellation';
            }
        }
    );

const cancelItemModal = document.getElementById('cancelItemModal');
const cancelItemModalClose = document.getElementById('cancelItemModalClose');
const cancelItemModalCancel = document.getElementById('cancelItemModalCancel');
const confirmCancelItem = document.getElementById('confirmCancelItem');
const itemCancellationReason = document.getElementById('itemCancellationReason');
const cancelItemConfirmation = document.getElementById('cancelItemConfirmation');
const couponWarning = document.getElementById('couponWarning');
let selectedItemOrderId = null;
let selectedItemId = null;
    document.querySelectorAll('.cancel-item-btn').forEach(button=>{
        button.addEventListener('click', async function(){
            selectedItemOrderId = this.dataset.orderId;
            selectedItemId = this.dataset.itemId;
            itemCancellationReason.value='';
            cancelItemConfirmation.textContent = `Are you sure want to cancel ${this.dataset.productName}?`;
            couponWarning.hidden=true;
            couponWarning.textContent='';
            try{
                const response = await fetch(`/account/orders/${encodeURIComponent(selectedItemOrderId)}/items/${encodeURIComponent(selectedItemId)}/cancellation-impact`,
                {
                    headers:{'Accept':'application/json'}
                }    
            );
            const result = await response.json();
            if(!response.ok||!result.success){
                showToastMessage(result.message||'Unable to check cancellation details','error');
                return;
            }
            if(result.couponRemoved){
                couponWarning.textContent= 
                `Warning: Cancelling this item will remove your coupon discount,
                 because your remaining order value will be below the minimum puchase requirment.`
                 couponWarning.hidden=false;
            }
            cancelItemModal.classList.add('show')
            }catch(error){
                console.log(error);
                showToastMessage('Unable to check cancellation details. Please try again.','error');
            }
        });
    });
    function closeCancelItemModal(){
        cancelItemModal.classList.remove('show');
        selectedItemOrderId = null;
        selectedItemId = null;
        itemCancellationReason.value='';
        confirmCancelItem.disabled= false;
        confirmCancelItem.textContent='Confirm Cancellation';
    }
    cancelItemModalClose.addEventListener('click',closeCancelItemModal);
    cancelItemModalCancel.addEventListener('click',closeCancelItemModal);
    cancelItemModal.querySelector('.cancel-order-modal-overlay')
    .addEventListener('click',closeCancelItemModal);
    confirmCancelItem.addEventListener('click',async function(){
        console.log('confirm button clicked item id and order id',selectedItemId,selectedItemOrderId)
        if(!selectedItemId||!selectedItemOrderId){
            return;
        }
        confirmCancelItem.disabled=true;
        confirmCancelItem.textContent = 'Cancelling..';
        try{
            const response = await fetch(`/account/orders/${encodeURIComponent(selectedItemOrderId)}/items/${encodeURIComponent(selectedItemId)}/cancel`,
                                    {
                                        method:'PATCH',
                                        headers:{'Content-Type':'application/json','Accept':'application/json'},
                                        body:JSON.stringify({cancellationReason:itemCancellationReason.value.trim()})
                                    }
        );
        const result = await response.json();
        if(!response.ok||!result.success){
            showToastMessage(result.message,'error');
            confirmCancelItem.disabled=false;
            confirmCancelItem.textContent='Confirm Cancellation';
            return;
        }
        closeCancelItemModal();
        showToastMessage(result.message,'success');
        setTimeout(()=>{
            window.location.reload();
        },1000)
    }catch(error){
        console.error('Cancel item error',error);
        showToastMessage('Unable to cancel item','error');
        confirmCancelItem.disabled = false;
        confirmCancelItem.textContent='Confirm Cancellation';
    }
    });

const returnOrderModal =document.getElementById('returnOrderModal');
const returnModalClose = document.getElementById('returnModalClose');
const returnModalCancel =document.getElementById('returnModalCancel');
const confirmReturnOrder = document.getElementById('confirmReturnOrder');
const returnReason = document.getElementById('returnReason');
const returnReasonError = document.getElementById('returnReasonError');
let selectedReturnOrderId = null;
let selectedReturnItemId = null;
document.querySelectorAll('.return-item-btn').forEach(button=>{
    button.addEventListener('click',function(){
        selectedReturnOrderId = this.dataset.orderId;
        selectedReturnItemId = this.dataset.itemId;
        returnReason.value='';
        returnReasonError.textContent='';
        document.querySelector('.return-confirmation-text').textContent=
        `Are you sure you want to return ${this.dataset.productName}?`;
        confirmReturnOrder.textContent ='Confirm Return';
        returnOrderModal.classList.add('show');
    })
});
function closeReturnModal(){
    returnOrderModal.classList.remove('show');
    selectedReturnItemId=null;
    selectedReturnOrderId=null;
    returnReason.value ='';
    returnReasonError.textContent='';
    confirmReturnOrder.disabled = false;
    confirmReturnOrder.textContent='Confirm Return';
}
returnModalCancel.addEventListener('click',closeReturnModal);
returnModalClose.addEventListener('click',closeReturnModal);
returnOrderModal.querySelector('.return-order-modal-overlay').addEventListener('click',closeReturnModal);
confirmReturnOrder.addEventListener('click',async function(){

    if(!selectedReturnOrderId||!selectedReturnItemId){
        return;
    }
    
    const reason = returnReason.value.trim();
    console.log('return reason',reason)
    if(!reason){
        returnReasonError.textContent = 'Return reason is required';
        returnReason.focus();
        return;
    }
    returnReasonError.textContent='';
    confirmReturnOrder.disabled=true;
    confirmReturnOrder.textContent='Submitting...';
    try{
        const response = await fetch(
            `/account/orders/${encodeURIComponent(selectedReturnOrderId)}/items/${encodeURIComponent(selectedReturnItemId)}/return`,
            {
                method:'PATCH',
                headers:{'Content-type':'application/json','Accept':'application/json'},
                body:JSON.stringify({returnReason:reason})
            }
        )
        const result = await response.json();
        if(!response.ok||!result.success){
            showToastMessage(result.message,'error');
            confirmReturnOrder.disabled=false;
            confirmReturnOrder.textContent='Confirm Return';
            return;
        }
        closeReturnModal();
        showToastMessage(result.message,'success');
        setTimeout(() => {
            window.location.reload();
        }, 1200);
    }catch(error){
        console.log('Return item error' ,error)
        showToastMessage('Unable to request item return','error');
        confirmReturnOrder.disabled=false;
        confirmReturnOrder.textContent='Confirm Return';
    }
});
    function showToastMessage(message,type){
        const toast = document.getElementById('toastMessage');
        const text = document.getElementById('toastMessageText');
         console.log('MESSAGE:', message);
         console.log('TYPE:', type);
        text.textContent = message;
        toast.classList.remove('success','error','show')
        toast.classList.add(type);
        toast.classList.add('show')
        setTimeout(() => {
            toast.classList.remove('show')
            toast.classList.remove('success')
            toast.classList.remove('error')
        }, 4000);
    }
</script>
</body>
</html>