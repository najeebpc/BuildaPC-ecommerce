<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>BuildaPC - Forgot Password</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    <link rel="stylesheet" href="/user/css/auth.css" />
  </head>
  <body>
    <div class="auth-page">
      <div class="auth-card">
        <div class="auth-header">
          <div class="auth-logo">BuildaPC</div>
          <h1 class="auth-title">Forgot Password</h1>
          <p class="auth-subtext">
            Enter your email and we’ll send you a code to reset your password.
          </p>
        </div>

        <form class="auth-form" action="/forgot-password" method="POST">
          <div class="form-group">
            <label>Email</label>
            <input
              type="email"
              name="email"
              placeholder="Enter your email"
              value="<%= formData?.email || '' %>"
            />
            <p class="error-text" id="mailError"><% if(message){ %> <%=message %> <% } %></p>
          </div>

          <button type="submit" class="btn-primary" id="sendOtpBtn">Send Verification code</button>
        </form>

        <div class="auth-footer">Back to <a href="/login">Login</a></div>
      </div>
    </div>
    <script>
      const forgotPasswordForm = document.querySelector('.auth-form');
      const sendOtpBtn = document.getElementById('sendOtpBtn');

      forgotPasswordForm.addEventListener('submit', () => {
        sendOtpBtn.disabled = true;
        sendOtpBtn.textContent = 'Sending...';
      });
    </script>
  </body>
</html>
