<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Order Summary | BuildaPC</title>
    <link rel="stylesheet" href="/user/css/home.css">
    <link rel="stylesheet" href="/user/css/checkout.css">
</head>

<body>

    <!-- Header -->
    <%- include('../../views/partials/user/header.ejs') %>


    <main class="checkout-page">
        <!-- =========================================
     CHECKOUT PROGRESS
========================================== -->
    <div class="checkout-progress">
        <!-- Order Summary -->
        <div class="progress-step active">
        <div class="progress-circle">
            1
        </div>
        <span>
            Order Summary
        </span>
        </div>
        <!-- Progress Line -->
        <div class="progress-line active"></div>
        <!-- Payment -->
        <div class="progress-step">
        <div class="progress-circle">
            2
        </div>
        <span>
            Payment
        </span>
        </div>
    </div>
        <!-- =========================================
             CHECKOUT CONTENT
        ========================================== -->
        <div class="checkout-content">
            <h1 class="checkout-title">
                Review Your Order
            </h1>
            <div class="checkout-container">
                <!-- ====================================
                     LEFT SIDE
                ====================================== -->
                <div class="checkout-left">
                    <!-- ===============================
                         DELIVERY ADDRESS
                    ================================== -->
                   <section class="checkout-section delivery-address">
    <div class="address-header">
        <h2 class="address-title">
            <svg
                class="address-icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
            >
                <path
                    d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z"
                ></path>
                <circle
                    cx="12"
                    cy="10"
                    r="2.5"
                ></circle>
            </svg>
            Delivery Address
        </h2>
        <% if (addresses&&addresses.length>0) { %>
            <button
                type="button"
                class="change-address-btn"
                id="changeAddressBtn"
            >
                Change
            </button>
        <% } %>
    </div>
    <% if (selectedAddress) { %>
        <!-- Currently selected address -->
        <div class="selected-address">
            <h3 class="address-name">
                <%= selectedAddress.fullName %>
            </h3>
            <p class="address-details">
                <%= selectedAddress.addressLine1 %>
                <% if (selectedAddress.addressLine2) { %>
                    , <%= selectedAddress.addressLine2 %>
                <% } %>

                , <%= selectedAddress.city %>
                , <%= selectedAddress.state %>
                -
                <%= selectedAddress.pincode %>
            </p>
            <p class="address-phone">
                Phone:
                <%= selectedAddress.phone %>
            </p>
        </div>
    <% } else { %>
        <!-- No saved address -->
        <div class="no-address">
            <p>
                No delivery address found.
            </p>
            <button
                type="button"
                id="addAddressBtn"
                class="add-address-btn"
            >
                + Add New Address
        </button>
        </div>
    <% } %>
    <!-- =====================================
         SAVED ADDRESS LIST
         Hidden initially
    ====================================== -->
    <% if (addresses && addresses.length > 0) { %>
        <div
            class="checkout-address-list"
            id="checkoutAddressList"
        >
            <div class="checkout-address-list-header">
                <h3>
                    Select Delivery Address
                </h3>
            </div>
            <% addresses.forEach(address => { %>
                <div
                    class="checkout-address-option
                    <%= selectedAddress &&
                        String(selectedAddress._id) === String(address._id)
                        ? 'selected'
                        : '' %>"
                        data-address-id="<%=address._id %>"
                        >
                    <div class="checkout-address-content">
                        <div class="checkout-address-top">
                            <h4>
                                <%= address.fullName %>
                            </h4>
                            <% if (address.isDefault) { %>
                                <span class="default-address-label">
                                    Default
                                </span>
                            <% } %>
                        </div>
                        <p>
                            <%= address.addressLine1 %>
                            <% if (address.addressLine2) { %>
                                , <%= address.addressLine2 %>
                            <% } %>

                            , <%= address.city %>,
                            <%= address.state %>
                            -
                            <%= address.pincode %>
                        </p>
                        <span class="checkout-address-phone">
                            Phone: <%= address.phone %>
                        </span>
                    </div>
                    <div class="checkout-address-actions">
                        <a
                            href="/account/address"
                            class="checkout-edit-address"
                        >
                            Edit
                        </a>
                        <button
                            type="button"
                            class="select-address-btn"
                        >
                            Select
                        </button>
                    </div>
                </div>
            <% }) %>
            <!-- Add new address -->
            <button
                type="button"
                class="checkout-add-address"
                id="checkoutAddAddressBtn"
            >
                + Add New Address
            </button>
        </div>
    <% } %>
</section>
                    <!-- =================================
                         ORDER ITEMS
                    ================================== -->
                    <section class="checkout-section order-items-section">
                        <h2 class="order-items-title">
                            Order Items
                        </h2>
                        <% items.forEach(item => { %>
                            <div class="checkout-item">
                                <!-- Product Image -->
                                <img
                                    src="<%= item.productId.primaryImage %>"
                                    alt="<%= item.productId.name %>"
                                    class="checkout-item-image"
                                >
                                <!-- Product Information -->
                                <div class="checkout-item-details">
                                    <h3 class="checkout-item-name">
                                        <%= item.productId.name %>
                                    </h3>
                                    <% if (item.variantId) { %>
                                        <% item.variantId.attributes.forEach(attribute => { %>
                                            <p class="checkout-item-variant">
                                                <%= attribute.name %>:
                                                <%= attribute.value %>
                                            </p>
                                        <% }) %>
                                    <% } %>
                                    <p class="checkout-item-quantity">
                                        Qty:
                                        <%= item.quantity %>
                                    </p>
                                   
<p class="checkout-item-price">
    <% const originalPrice = Number(
        item.originalPrice ??
        (item.variantId ? item.variantId.price : item.productId.basePrice)
    ); %>

    <% const discountAmount = Number(item.discountAmount ?? 0); %>
    <% const finalPrice = Number(
        item.finalPrice ?? (originalPrice - discountAmount)
    ); %>

    <% if (discountAmount > 0) { %>
        <span class="checkout-original-price">
            ₹<%= originalPrice.toLocaleString('en-IN') %>
        </span>

        <span class="checkout-discounted-price">
            ₹<%= finalPrice.toLocaleString('en-IN') %>
        </span>

        <span class="checkout-offer-badge">
            <%= Number(item.discountPercentage ??
                Math.round((discountAmount / originalPrice) * 100)) %>% OFF
        </span>
    <% } else { %>
        <span class="checkout-regular-price">
            ₹<%= originalPrice.toLocaleString('en-IN') %>
        </span>
    <% } %>

    <span class="checkout-item-line-total">
        Item total: ₹<%= Number(finalPrice * item.quantity).toLocaleString('en-IN') %>
    </span>
</p>

                                </div>
                            </div>
                        <% }) %>
                    </section>
                </div>
                <!-- =====================================
                     RIGHT SIDE
                ====================================== -->
                <aside class="order-summary">
                    <h2 class="order-summary-title">
                        Order Summary
                    </h2>
                    
<%
    const originalSubtotal = items.reduce((total, item) => {
        const price = Number(
            item.originalPrice ??
            (item.variantId ? item.variantId.price : item.productId.basePrice)
        );

        return total + price * item.quantity;
    }, 0);

    const offerSavings = items.reduce((total, item) => {
        const discount = Number(item.discountAmount ?? 0);
        return total + discount * item.quantity;
    }, 0);

    const subtotal = Math.max(0, originalSubtotal - offerSavings);

    const totalItems = items.reduce(
        (total, item) => total + item.quantity,
        0
    );
%>

                    <!-- Subtotal -->
                    <div class="summary-row">
                        <span>
                            Subtotal (<%= totalItems %> items)
                        </span>
                        <span class="summary-price">
                            ₹<%= Number(subtotal).toLocaleString('en-IN') %>
                        </span>
                    </div>
                    
<% if (offerSavings > 0) { %>
    <div class="summary-row offer-savings-row">
        <span>Offer Savings</span>
        <span class="summary-price offer-savings-price">
            −₹<%= Number(offerSavings).toLocaleString('en-IN') %>
        </span>
    </div>
<% } %>

                    <!-- Shipping -->
                    <div class="summary-row">
                        <span>
                            Shipping Charge
                        </span>
                        <span class="shipping-free">
                            Free
                        </span>
                    </div>
                  <!-- Coupon -->
                    <div class="coupon-section"
                         id="couponSection"
                         data-applied-coupon='<%-JSON.stringify(
                            appliedCoupon?{
                                code:appliedCoupon.code,
                                discount:appliedCoupon.discount,
                                payableAmount:appliedCoupon.payableAmount
                            }:null
                         ) %>'
                    >
                        <label for="couponCode" class="coupon-title">
                            Apply Coupon
                        </label>
                    <div class="coupon-form">
                        <input
                        type="text"
                        id="couponCode"
                        class="coupon-input"
                        placeholder="Enter coupon code"
                        autocomplete="off"
                    >
                    <button
                        type="button"
                        class="coupon-btn"
                        id="applyCouponBtn">
                        Apply
                    </button>
                    </div>
                        <p id="couponMessage" class="coupon-message" hidden></p>
                <div id="appliedCoupon" class="applied-coupon" hidden>
                    <div>
                        <strong id="appliedCouponCode"></strong>
                            <p>Coupon applied </p>
                    </div>
                    <button type="button" id="removeCouponBtn">
                        Remove
                    </button>
                    </div>
                </div>
                    <!-- Discount -->
                <div class="summary-row" id="couponDiscountRow" hidden>
                    <span>Coupon Discount</span>
                    <span class="summary-price" id="couponDiscountAmount">
                        −₹0
                    </span>
                </div>
                    <!-- Divider -->
                    <div class="summary-divider"></div>
                    <!-- Total -->
                    <div class="summary-total">
                        <span>
                            Total
                        </span>
                        <span class="summary-total-price" id="checkoutTotal"
                              data-subtotal="<%=Number(subtotal)%>">
                            ₹<%= Number(subtotal).toLocaleString('en-IN') %>
                        </span>
                    </div>
                    <!-- Continue -->
                    <button
                        type="button"
                        class="continue-payment-btn"
                    >
                        Continue to Payment
                    </button>
                    <!-- Back -->
                     <a href="/cart">
                    <button
                        type="button"
                        class="back-address-btn"
                    >
                        Back to Cart
                    </button>
                    </a>
                </aside>
            </div>
        </div>
    </main>
    <!-- address modal -->
 <div class="checkout-address-modal" id="checkoutAddressModal">
    <div class="checkout-address-modal-overlay"></div>
    <div class="checkout-address-modal-box">
        <div class="checkout-address-modal-header">
            <h3>Add New Address</h3>
            <button
                type="button"
                id="closeCheckoutAddressModal"
                class="checkout-address-modal-close"
            >
                ×
            </button>
        </div>
        <form id="checkoutAddressForm">
            <div class="row-2">
                <div class="form-group">
                    <label for="checkoutFullName">
                        Full Name
                    </label>
                    <input
                        type="text"
                        id="checkoutFullName"
                        name="fullName"
                        placeholder="Full Name"
                    >
                    <p
                        class="error-text"
                        id="checkoutFullNameError"
                    ></p>
                </div>
                <div class="form-group">
                    <label for="checkoutPhone">
                        Phone Number
                    </label>
                    <input
                        type="text"
                        id="checkoutPhone"
                        name="phone"
                        placeholder="Phone Number"
                    >
                    <p
                        class="error-text"
                        id="checkoutPhoneError"
                    ></p>
                </div>
            </div>
            <div class="form-group">
                <label for="checkoutAddressLine1">
                    Address
                </label>
                <input
                    type="text"
                    id="checkoutAddressLine1"
                    name="addressLine1"
                    placeholder="House No., Building Name"
                >
                <p
                    class="error-text"
                    id="checkoutAddressLine1Error"
                ></p>
            </div>
            <div class="form-group">
                <label for="checkoutAddressLine2">
                    Area / Road
                </label>
                <input
                    type="text"
                    id="checkoutAddressLine2"
                    name="addressLine2"
                    placeholder="Road name, Area, Colony"
                >
                <p
                    class="error-text"
                    id="checkoutAddressLine2Error"
                ></p>
            </div>
            <div class="row-2">
                <div class="form-group">
                    <label for="checkoutCity">
                        City
                    </label>
                    <input
                        type="text"
                        id="checkoutCity"
                        name="city"
                        placeholder="City"
                    >
                    <p
                        class="error-text"
                        id="checkoutCityError"
                    ></p>
                </div>
                <div class="form-group">
                    <label for="checkoutState">
                        State
                    </label>

                    <select
                        id="checkoutState"
                        name="state"
                    >
                        <option value="">
                            Select State
                        </option>

                        <option value="Kerala">
                            Kerala
                        </option>

                        <option value="Karnataka">
                            Karnataka
                        </option>
                    </select>
                    <p
                        class="error-text"
                        id="checkoutStateError"
                    ></p>
                </div>
            </div>
            <div class="form-group">

                <label for="checkoutPincode">
                    Pincode
                </label>
                <input
                    type="text"
                    id="checkoutPincode"
                    name="pincode"
                    placeholder="Pincode"
                    maxlength="6"
                >
                <p
                    class="error-text"
                    id="checkoutPincodeError"
                ></p>
            </div>
            <div class="checkout-address-modal-actions">
                <button
                    type="button"
                    id="cancelCheckoutAddress"
                    class="address-cancel-btn"
                >
                    Cancel
                </button>
                <button
                    type="submit"
                    id="saveCheckoutAddress"
                    class="address-confirm-btn"
                >
                    Save Address
                </button>
            </div>
        </form>
    </div>
</div>
    <!-- Footer -->
    <%- include('../../views/partials/user/footer.ejs') %>
<script>
    let selectedAddressId = '<%= selectedAddress ? selectedAddress._id : "" %>';
  const changeAddressBtn = document.getElementById('changeAddressBtn');

if (changeAddressBtn) {

    changeAddressBtn.addEventListener(
        'click',
        function () {

            const checkoutAddressList =document.getElementById( 'checkoutAddressList' );

            if (!checkoutAddressList) return;

            checkoutAddressList.classList.toggle(
                'show'
            );
        }
    );
}
    const selectAddressButtons = document.querySelectorAll('.select-address-btn');
        selectAddressButtons.forEach(button=>{
        button.addEventListener('click',function(){
            const addressOption = this.closest('.checkout-address-option');
            if(!addressOption)return;
            selectedAddressId = addressOption.dataset.addressId;

            document.querySelectorAll('.checkout-address-option').forEach(option=>{
                option.classList.remove('selected');
            });
            addressOption.classList.add('selected');
            updateContinuePaymentButton();
            const addressName= addressOption.querySelector('.checkout-address-top h4').textContent.trim();
            const addressDetails = addressOption.querySelector('.checkout-address-content p').textContent.trim();
            const addressPhone = addressOption.querySelector('.checkout-address-phone').textContent.trim();
            const selectedAddress = document.querySelector('.selected-address');
            if(selectedAddress){
                const nameElement = selectedAddress.querySelector('.address-name');
                const detailsElement = selectedAddress.querySelector('.address-details');
                const phoneElement = selectedAddress.querySelector('.address-phone');
                if (nameElement) {
                    nameElement.textContent = addressName;
                }
                if (detailsElement) {
                    detailsElement.textContent = addressDetails;
                }
                if (phoneElement) {
                    phoneElement.textContent = addressPhone;
                }
            }
            checkoutAddressList.classList.remove('show');
        })
    })
    const continuePaymentBtn = document.querySelector('.continue-payment-btn');
    if(continuePaymentBtn){
        continuePaymentBtn.addEventListener('click',async function(){
            if(!selectedAddressId){
                showToastMessage('Please select a delivery address','error');
                return;
            }
            try{
                const response = await fetch('/checkout/validate',{
                    method:'POST',
                    headers:{'Accept':'application/json'}
                });
                const result = await response.json();
                if(!response.ok||!result.success){
                    showToastMessage(result.message,'error');
                    return;
                }
                console.log('selected addressId',selectedAddressId);
                window.location.href=`/checkout/payment?addressId=${selectedAddressId}`;
            }catch(error){
                showToastMessage('Unable to continue to payment','error');
            }
        })
    }
const checkoutAddressModal =
    document.getElementById('checkoutAddressModal');
const addAddressBtn =
    document.getElementById('addAddressBtn');
const checkoutAddAddressBtn =
    document.getElementById('checkoutAddAddressBtn');
const closeCheckoutAddressModal =
    document.getElementById('closeCheckoutAddressModal');
const cancelCheckoutAddress =
    document.getElementById('cancelCheckoutAddress');
const checkoutAddressForm =
    document.getElementById('checkoutAddressForm');
function openCheckoutAddressModal() {
    checkoutAddressModal.classList.add('show');
}
function closeCheckoutAddressModalFunction() {
    checkoutAddressModal.classList.remove('show');
    checkoutAddressForm.reset();
    clearCheckoutAddressErrors();
}
if (addAddressBtn) {
addAddressBtn.addEventListener( 'click', openCheckoutAddressModal);
}
if (checkoutAddAddressBtn) {
    checkoutAddAddressBtn.addEventListener( 'click',openCheckoutAddressModal);
}
if (closeCheckoutAddressModal) {
    closeCheckoutAddressModal.addEventListener('click', closeCheckoutAddressModalFunction);
}
if (cancelCheckoutAddress) {
    cancelCheckoutAddress.addEventListener('click', closeCheckoutAddressModalFunction);

}
function clearCheckoutAddressErrors() {
    document.getElementById( 'checkoutFullNameError').textContent = '';
    document.getElementById('checkoutPhoneError').textContent = '';
    document.getElementById('checkoutAddressLine1Error').textContent = '';
    document.getElementById('checkoutAddressLine2Error').textContent = '';
    document.getElementById('checkoutCityError').textContent = '';
    document.getElementById('checkoutStateError' ).textContent = '';
    document.getElementById('checkoutPincodeError').textContent = '';
 
}
function addNewAddressToCheckout(address) {

    const deliverySection =
        document.querySelector('.delivery-address');

    if (!deliverySection) return;


    /*
     * Remove "No delivery address found"
     */
    const noAddress =
        deliverySection.querySelector('.no-address');

    if (noAddress) {
        noAddress.remove();
    }


    /*
     * Create selected address
     * if it does not already exist.
     */
    let selectedAddress =
        deliverySection.querySelector(
            '.selected-address'
        );

    if (!selectedAddress) {

        selectedAddress =
            document.createElement('div');

        selectedAddress.className =
            'selected-address';

        selectedAddress.innerHTML = `
            <h3 class="address-name"></h3>

            <p class="address-details"></p>

            <p class="address-phone"></p>
        `;

        const addressHeader =
            deliverySection.querySelector(
                '.address-header'
            );

        addressHeader.insertAdjacentElement(
            'afterend',
            selectedAddress
        );
    }


    /*
     * Update selected address display.
     */
    selectedAddress
        .querySelector('.address-name')
        .textContent =
        address.fullName;

    selectedAddress
        .querySelector('.address-details')
        .textContent =
        `${address.addressLine1}${
            address.addressLine2
                ? ', ' + address.addressLine2
                : ''
        }, ${address.city}, ${address.state} - ${
            address.pincode
        }`;

    selectedAddress
        .querySelector('.address-phone')
        .textContent =
        `Phone: ${address.phone}`;


    /*
     * Create Change button
     * if it doesn't exist.
     */
    let changeAddressBtn =
        document.getElementById(
            'changeAddressBtn'
        );

    if (!changeAddressBtn) {

        changeAddressBtn =
            document.createElement('button');

        changeAddressBtn.type =
            'button';

        changeAddressBtn.className =
            'change-address-btn';

        changeAddressBtn.id =
            'changeAddressBtn';

        changeAddressBtn.textContent =
            'Change';

        const addressHeader =
            deliverySection.querySelector(
                '.address-header'
            );

        addressHeader.appendChild(
            changeAddressBtn
        );

        changeAddressBtn.addEventListener(
            'click',
            function () {

                const addressList =
                    document.getElementById(
                        'checkoutAddressList'
                    );

                if (!addressList) return;

                addressList.classList.toggle(
                    'show'
                );
            }
        );
    }


    /*
     * Get or create address list.
     */
    let addressList =
        document.getElementById(
            'checkoutAddressList'
        );

    if (!addressList) {

        addressList =
            document.createElement('div');

        addressList.className =
            'checkout-address-list';

        addressList.id =
            'checkoutAddressList';

        addressList.innerHTML = `
            <div class="checkout-address-list-header">
                <h3>
                    Select Delivery Address
                </h3>
            </div>
        `;

        deliverySection.appendChild(
            addressList
        );
    }


    /*
     * Remove selected state
     * from existing addresses.
     */
    addressList
        .querySelectorAll(
            '.checkout-address-option'
        )
        .forEach(option => {

            option.classList.remove(
                'selected'
            );
        });


    /*
     * Create new address option.
     */
    const addressOption =
        document.createElement('div');

    addressOption.className =
        'checkout-address-option selected';

    addressOption.dataset.addressId =
        address._id;


    addressOption.innerHTML = `
        <div class="checkout-address-content">

            <div class="checkout-address-top">

                <h4>
                    ${address.fullName}
                </h4>

            </div>

            <p>
                ${address.addressLine1}${
                    address.addressLine2
                        ? ', ' + address.addressLine2
                        : ''
                },
                ${address.city},
                ${address.state}
                - ${address.pincode}
            </p>

            <span class="checkout-address-phone">
                Phone: ${address.phone}
            </span>

        </div>

        <div class="checkout-address-actions">

            <a
                href="/account/address"
                class="checkout-edit-address"
            >
                Edit
            </a>

            <button
                type="button"
                class="select-address-btn"
            >
                Select
            </button>

        </div>
    `;


    /*
     * Add new address to list.
     */
    const addAddressButton = document.getElementById('checkoutAddAddressBtn');

if (addAddressButton) {
    addressList.insertBefore(addressOption, addAddressButton);
} else {
    addressList.appendChild(addressOption);
}

    /*
     * Select new address.
     */
    selectedAddressId =
        address._id;


    /*
     * Enable Continue to Payment.
     */
    updateContinuePaymentButton();


    /*
     * Select button for new address.
     */
    const selectButton =
        addressOption.querySelector(
            '.select-address-btn'
        );

    selectButton.addEventListener(
        'click',
        function () {

            selectedAddressId =
                addressOption.dataset.addressId;


            addressList
                .querySelectorAll(
                    '.checkout-address-option'
                )
                .forEach(option => {

                    option.classList.remove(
                        'selected'
                    );
                });


            addressOption.classList.add(
                'selected'
            );
            selectedAddress
                .querySelector('.address-name')
                .textContent =
                address.fullName;

            selectedAddress
                .querySelector('.address-details')
                .textContent =
                `${address.addressLine1}${
                    address.addressLine2
                        ? ', ' + address.addressLine2
                        : ''
                }, ${address.city}, ${
                    address.state
                } - ${address.pincode}`;

            selectedAddress
                .querySelector('.address-phone')
                .textContent =
                `Phone: ${address.phone}`;


            updateContinuePaymentButton();


            addressList.classList.remove(
                'show'
            );
        }
    );
}
function updateSelectedAddressDisplay(addressOption) {

    const addressName =
        addressOption
            .querySelector('.checkout-address-top h4')
            .textContent
            .trim();

    const addressDetails =
        addressOption
            .querySelector('.checkout-address-content p')
            .textContent
            .trim();

    const addressPhone =
        addressOption
            .querySelector('.checkout-address-phone')
            .textContent
            .trim();

    let selectedAddress =
        document.querySelector('.selected-address');

    // If this is the first address,
    // create the selected address section.
    if (!selectedAddress) {

        const deliverySection =
            document.querySelector('.delivery-address');

        const addressHeader =
            deliverySection.querySelector('.address-header');

        selectedAddress =
            document.createElement('div');

        selectedAddress.className =
            'selected-address';

        selectedAddress.innerHTML = `
            <h3 class="address-name"></h3>
            <p class="address-details"></p>
            <p class="address-phone"></p>
        `;

        addressHeader.insertAdjacentElement(
            'afterend',
            selectedAddress
        );
    }
    const nameElement =
        selectedAddress.querySelector('.address-name');

    const detailsElement =
        selectedAddress.querySelector('.address-details');

    const phoneElement =
        selectedAddress.querySelector('.address-phone');

    if (nameElement) {
        nameElement.textContent =
            addressName;
    }

    if (detailsElement) {
        detailsElement.textContent =
            addressDetails;
    }

    if (phoneElement) {
        phoneElement.textContent =
            addressPhone;
    }
}
checkoutAddressForm.addEventListener(
    'submit',
    async function (e) {
        e.preventDefault();
        clearCheckoutAddressErrors();
        let valid = true;
        const fullName =
            document.getElementById('checkoutFullName');
        const phone =
            document.getElementById('checkoutPhone');
        const addressLine1 =
            document.getElementById('checkoutAddressLine1');
        const addressLine2 =
            document.getElementById('checkoutAddressLine2');
        const city =
            document.getElementById('checkoutCity');
        const state =
            document.getElementById('checkoutState');
        const pincode =
            document.getElementById('checkoutPincode');
        // Full name
        const nameValue = fullName.value.trim();
        if (
           nameValue.length < 3||
           !/^[\p{L}\p{M}]+(?:[ .'-][\p{L}\p{M}]+)*$/u.test(nameValue)
        ) {

            document.getElementById(
                'checkoutFullNameError'
            ).textContent =
                'Plese enter a valid full name';

            valid = false;
        }


        // Phone
        if (!/^[6-9]\d{9}$/.test(phone.value.trim())) {

            document.getElementById(
                'checkoutPhoneError'
            ).textContent =
                'Please enter a valid phone number';

            valid = false;
        }


        // Address line 1
        if (
            !addressLine1.value.trim() ||
            addressLine1.value.trim().length < 5
        ) {

            document.getElementById(
                'checkoutAddressLine1Error'
            ).textContent =
                'Please enter a valid address';

            valid = false;
        }


        // Address line 2
        if (
            !addressLine2.value.trim() ||
            addressLine2.value.trim().length < 5
        ) {

            document.getElementById(
                'checkoutAddressLine2Error'
            ).textContent =
                'Please enter a valid address';

            valid = false;
        }


        // City
        if (
            !city.value.trim() ||
            city.value.trim().length < 3
        ) {

            document.getElementById(
                'checkoutCityError'
            ).textContent =
                'Please enter a valid city';

            valid = false;
        }


        // State
        if (!state.value) {

            document.getElementById(
                'checkoutStateError'
            ).textContent =
                'Please select a state';

            valid = false;
        }


        // Pincode
        if (!/^\d{6}$/.test(pincode.value.trim())) {

            document.getElementById(
                'checkoutPincodeError'
            ).textContent =
                'Pincode must be exactly 6 digits';

            valid = false;
        }


        if (!valid) {
            return;
        }


        try {

            const formData = new URLSearchParams(
            new FormData(checkoutAddressForm)
            )
            const response = await fetch(
                '/account/address',
                {
                    method: 'POST',
                    headers: {
                        'Accept': 'application/json','Content-Type': 'application/x-www-form-urlencoded'
                    },
                    body: formData
                }
            );
            const result = await response.json();
                console.log('ADD ADDRESS RESPONSE:', result);
                console.log('RESPONSE STATUS:', response.status);
            if (!response.ok || !result.success) {
                showToastMessage(
                    result.message || 'Unable to add address',
                    'error'
                );
                return;
            }
            console.log( 'New address:', result.address
            );
            selectedAddressId = result.address._id;
            addNewAddressToCheckout(result.address);
            showToastMessage('Address added successfully','success');
            closeCheckoutAddressModalFunction();
        } catch (error) {
            console.error(
                'Error saving checkout address:',
                error
            );
            showToastMessage(
                'Unable to save address',
                'error'
            );
        }
    }
);
updateContinuePaymentButton();
   function updateContinuePaymentButton() {

