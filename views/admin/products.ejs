<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <title>Product Management | BuildaPC Admin</title>

    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/cropperjs@1.6.2/dist/cropper.min.css"
    />
    <link href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css" rel="stylesheet" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    />
    <link rel="stylesheet" href="/admin/css/admin-base.css" />
    <link rel="stylesheet" href="/admin/css/products.css" />
  </head>
  <body>
    <div class="admin-wrapper">
      <%- include('../partials/admin/sidebar',{active:'products'}) %>
      <main class="admin-content">
        <%- include('../partials/admin/topbar') %>

        <div class="product-page-header">
          <div>
            <h1 class="page-title">Product Management</h1>
            <p class="page-subtitle">Manage your product inventory</p>
          </div>
          <button type="button" class="add-product-btn" onclick="openAddProductModal()">
            <span class="add-product-icon">+</span>
            Add New Product
          </button>
        </div>
        <div id="productMessage" class="product-message"></div>

        <div class="product-card">
          <div class="product-toolbar">
            <div class="product-search">
              <form method="GET" action="/admin/products" class="search-form">
                <input
                  type="text"
                  name="search"
                  placeholder="Search products by name or category..."
                  value="<%= search || '' %>"
                />
                <button type="submit" class="search-btn">Search</button>
                <% if (search) { %>
                <a href="/admin/products" class="clear-search"> Cancel </a>
                <% } %>
              </form>
            </div>
            <div class="product-filter">
              <select id="productFilter">
                <option value="all">All Products</option>
                <option value="listed">Listed Products</option>
                <option value="unlisted">Unlisted Products</option>
              </select>
            </div>
          </div>

          <div class="product-table-wrapper">
            <table class="product-table">
              <thead>
                <tr>
                  <th class="product-name-column">Product Name</th>
                  <th>Product Type</th>
                  <th>Category</th>
                  <th>Price</th>
                  <th>Stock Level</th>
                  <th>Variants</th>
                  <th>List / Unlist</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% if (products && products.length > 0) { %> <% products.forEach(product => { %>
                <tr>
                  <td>
                    <%= product.name %>
                  </td>
                  <td>
                    <%= product.productType %>
                  </td>
                  <td>
                    <%= product.categoryId ? product.categoryId.name : 'N/A' %>
                  </td>
                  <td>
                    <%= product.basePrice %>
                  </td>
                  <td>
                    <%= product.totalStock %>
                  </td>
                  <td>
                    <div class="variant-cell">
                      <span class="variant-count"><%=product.variantCount%></span>
                      <a
                        type="button"
                        class="manage-variants-link"
                        onclick="
                          openManageVariantsModal('<%=product._id%>');
                          return false;
                        "
                      >
                        Manage
                      </a>
                    </div>
                  </td>
                  <td>
                    <label class="product-toggle">
                      <% if (product.isListed) { %>
                      <input
                        type="checkbox"
                        checked
                        onchange="toggleProductStatus('<%= product._id %>', this.checked, this)"
                      />
                      <% } else { %>
                      <input
                        type="checkbox"
                        onchange="toggleProductStatus('<%= product._id %>', this.checked, this)"
                      />
                      <% } %>

                      <span class="product-toggle-slider"></span>
                    </label>
                  </td>
                  <td>
                    <div class="product-actions">
                      <a
                        href="#"
                        class="edit-product-link"
                        data-product="<%= encodeURIComponent(JSON.stringify(product)) %>"
                      >
                        Edit
                      </a>
                      <a
                        href="#"
                        class="delete-product-link"
                        data-product-id="<%= product._id %>"
                        data-product-name="<%= product.name %>"
                      >
                        Delete
                      </a>
                    </div>
                  </td>
                </tr>
                <% }) %>
                <% } else { %>
                <tr>
                  <td colspan="8" class="product-empty-row">No products found</td>
                </tr>

                <% } %>
              </tbody>
            </table>
          </div>
        </div>

        <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
        <div class="product-pagination">
          <% for (let i = 1; i <= totalPages; i++) { %>
          <a
            href="/admin/products?page=<%= i %>&search=<%= search || '' %>"
            class="<%= currentPage === i ? 'active' : '' %>"
          >
            <%= i %>
          </a>
          <% } %>
        </div>
        <% } %>
      </main>
    </div>
    <div class="product-modal-overlay" id="productModal">
      <div class="product-modal">
        <div class="product-modal-header">
          <div>
            <h2 id="productModalTitle">Add New Product</h2>
            <p id="productModalSubtitle">Create a new product</p>
          </div>
          <button type="button" class="product-modal-close" onclick="closeProductModal()">×</button>
        </div>

        <div class="product-modal-body">
          <div class="product-form-section">
            <h3>Basic Information</h3>
            <div class="product-form-group">
              <label for="productName"> Product Name </label>
              <input type="text" id="productName" class="product-input" placeholder="" />
              <p id="productNameError" class="product-field-error"></p>
            </div>
            <div class="product-form-row">
              <div class="product-form-group">
                <label for="productPrice"> Price </label>
                <input
                  type="number"
                  id="productPrice"
                  class="product-input"
                  placeholder="₹499.99"
                  min="0"
                  step="0.01"
                />
                <p id="productPriceError" class="product-field-error"></p>
              </div>
              <div class="product-form-group">
                <label for="productStock"> Stock Level </label>
                <input
                  type="number"
                  id="productStock"
                  class="product-input"
                  placeholder="1"
                  min="0"
                />
                <p id="productStockError" class="product-field-error"></p>
              </div>
            </div>
          </div>

          <div class="product-form-section">
            <h3>Classification</h3>
            <div class="product-form-row">
              <div class="product-form-group">
                <label for="productType"> Product Type </label>
                <select id="productType" class="product-input">
                  <option value="component">PC Component</option>
                  <option value="pre_built">Pre-Built PC</option>
                </select>
                <p id="productTypeError" class="product-field-error"></p>
              </div>
              <div class="product-form-group">
                <label for="productCategory"> Specific Category </label>
                <select id="productCategory" class="product-input">
                  <option value="">Select Category</option>
                  <% if (categories) { %>
                  <% categories.forEach(category => { %>
                  <option value="<%= category._id %>"><%= category.name %></option>
                  <% }) %>
                  <% } %>
                </select>
                <p id="productCategoryError" class="product-field-error"></p>
              </div>
            </div>
          </div>
          <div class="product-form-section">
            <h3>Image Management</h3>
            <div class="product-form-group">
              <label> Primary Product Image </label>
              <div class="primary-image-wrapper">
                <div class="primary-image-upload" id="primaryImageUpload">
                  <span class="gallery-placeholder">+</span>
                  <input
                    type="file"
                    id="primaryImageInput"
                    accept="image/png,image/jpeg,image/webp"
                    hidden
                  />
                </div>
              </div>
              <p id="primaryImageError" class="product-field-error"></p>
            </div>
            <div class="product-form-group">
              <label> Additional Images </label>
              <div class="gallery-upload-grid" id="galleryUploadGrid"></div>
              <button type="button" class="add-gallery-image-btn" id="addGalleryImageBtn">
                + Add Image
              </button>
              <p class="product-image-help">
                Add additional product images. At least 3 images are required in total.
              </p>
            </div>
          </div>

          <div class="product-form-section">
            <div class="product-form-group">
              <label for="productDescription"> Short Description </label>
              <textarea
                id="productDescription"
                class="product-textarea"
                placeholder="Brief product summary (1-5 sentences)"
              ></textarea>
            </div>
          </div>

          <div class="product-form-section">
            <div class="product-form-group">
              <label> Product Features </label>
              <div id="productFeaturesEditor"></div>

              <p class="product-editor-help">
                Use the editor above to format your text with bold, italic, and bullet points
              </p>
            </div>
          </div>

          <div class="product-form-section">
            <div class="product-form-group">
              <label> Product Specifications </label>
              <div id="specificationsContainer" class="specifications-container"></div>
              <button type="button" class="add-specification-btn" onclick="addSpecification()">
                <span>+</span>
                Add Specification
              </button>
            </div>
          </div>
        </div>

        <div class="product-modal-footer">
          <button
            type="button"
            class="product-modal-cancel-btn"
            id="productModalCancelBtn"
            onclick="closeProductModal()"
          >
            Cancel
          </button>
          <button
            type="button"
            class="product-modal-save-btn"
            id="productModalSaveBtn"
            onclick="saveProduct()"
          >
            Save Product
          </button>
        </div>
      </div>
    </div>
    <div class="image-crop-modal" id="imageCropModal">
      <div class="image-crop-modal-content">
        <div class="image-crop-header">
          <h3>Crop Image</h3>
          <button type="button" id="closeCropModal" class="crop-close-btn">×</button>
        </div>
        <div class="crop-container">
          <img id="cropImage" src="" alt="Crop image" />
        </div>
        <div class="image-crop-footer">
          <button type="button" id="cancelCropBtn" class="product-modal-cancel-btn">Cancel</button>
          <button type="button" id="applyCropBtn" class="product-modal-save-btn">Apply Crop</button>
        </div>
      </div>
    </div>
    <div class="product-delete-modal-overlay" id="deleteProductModal">
      <div class="product-delete-modal-box">
        <div class="product-delete-modal-header">
          <h3>Delete Product</h3>
          <button
            type="button"
            class="product-delete-modal-close"
            id="closeProductDeleteModal"
            onclick="closeDeleteProductModal()"
          >
            ×
          </button>
        </div>
        <div class="product-delete-modal-body">
          <div class="product-delete-warning-icon">⚠️</div>
          <p id="productDeleteModalText"></p>
        </div>
        <div class="product-delete-modal-footer">
          <button
            type="button"
            class="product-delete-cancel-btn"
            id="cancelProductDeleteBtn"
            onclick="closeDeleteProductModal()"
          >
            Cancel
          </button>
          <button type="button" class="product-delete-confirm-btn" id="confirmProductDeleteBtn">
            Delete Product
          </button>
        </div>
      </div>
    </div>

    <div id="manageVariantsModal" class="variant-modal-overlay" style="display: none">
      <div class="variant-modal">
        <div class="variant-modal-header">
          <div>
            <h2 id="variantModalTitle">Manage Variants</h2>
            <p id="variantProductName" class="variant-product-name"></p>
          </div>
          <button type="button" class="variant-modal-close" onclick="closeManageVariantsModal()">
            &times;
          </button>
        </div>

        <div id="variantResponseMessage" class="variant-response-message"></div>
        <div id="variantListView" class="variant-modal-content">
          <div class="variant-attributes-section">
            <div class="variant-section-heading">
              <h3>Variant Attributes</h3>
              <p>Attributes defined by the product category</p>
            </div>
            <div id="variantAttributesContainer" class="variant-attributes-list"></div>
          </div>

          <div class="product-variants-section">
            <div class="variant-section-heading variant-list-heading">
              <div>
                <h3>Product Variants</h3>
                <p>Manage the available combinations for this product</p>
              </div>
              <button type="button" class="variant-add-btn" onclick="showAddVariantForm()">
                <span>+</span>
                Add Variant
              </button>
            </div>
            <div id="variantsContainer" class="variants-list"></div>
          </div>
        </div>

        <div id="variantFormView" class="variant-modal-content" style="display: none">
          <div class="variant-form-heading">
            <h3 id="variantFormTitle">Add Variant</h3>
            <p>Enter the values and stock details for this variant.</p>
          </div>
          <form id="variantForm">
            <div id="variantFormAttributes" class="variant-form-attributes"></div>

            <div class="variant-form-group">
              <label for="variantPrice"> Price </label>
              <input
                type="number"
                id="variantPrice"
                min="0"
                step="0.01"
                placeholder="Enter variant price"
              />
              <p id="variantPriceError" class="variant-form-error"></p>
            </div>

            <div class="variant-form-group">
              <label for="variantStock"> Stock </label>
              <input
                type="number"
                id="variantStock"
                min="0"
                step="1"
                placeholder="Enter stock quantity"
              />
              <p id="variantStockError" class="variant-form-error"></p>
            </div>

            <div class="variant-form-group">
              <label for="variantStatus"> Status </label>
              <select id="variantStatus">
                <option value="true">Active</option>

                <option value="false">Inactive</option>
              </select>
            </div>

            <div class="variant-form-actions">
              <button type="button" class="variant-cancel-btn" onclick="showVariantList()">
                Cancel
              </button>
              <button type="submit" class="variant-save-btn">Save Variant</button>
            </div>
          </form>
        </div>

        <div id="variantModalFooter" class="variant-modal-footer">
          <button type="button" class="variant-close-btn" onclick="closeManageVariantsModal()">
            Close
          </button>
        </div>
      </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/cropperjs@1.6.2/dist/cropper.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"></script>
    <script src="/admin/js/products.js"></script>
  </body>
</html>
