<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Dashboard | BuildaPC Admin</title>

    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@500;700&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    />
    <link rel="stylesheet" href="/admin/css/admin-base.css" />

    <link rel="stylesheet" href="/admin/css/dashboard.css" />
  </head>
  <body>
    <div class="admin-wrapper">
      <%- include('../partials/admin/sidebar') %>

      <main class="admin-content has-topbar">
        <%- include('../partials/admin/topbar') %>
        <div class="dashboard-page">
          <div class="stats-grid">
            <div class="stat-card">
              <span>Total Revenue</span>
              <h3>₹<%= Number(totalRevenue || 0).toLocaleString('en-IN') %></h3>
            </div>

            <div class="stat-card">
              <span>Delivered Orders</span>
              <h3><%= totalOrders || 0 %></h3>
            </div>

            <div class="stat-card">
              <span>Total Users</span>
              <h3><%= totalUsers || 0 %></h3>
            </div>

            <div class="stat-card">
              <span>New Orders Today</span>
              <h3><%= newOrdersToday || 0 %></h3>
            </div>
          </div>
          <div class="dashboard-lists">
            <section class="dashboard-card">
              <h3>Top 10 Best-Selling Products</h3>

              <% if (topProducts.length) { %>
              <div class="dashboard-table-wrapper">
                <table class="dashboard-table">
                  <thead>
                    <tr>
                      <th>#</th>
                      <th>Product</th>
                      <th>Quantity Sold</th>
                      <th>Revenue</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% topProducts.forEach((product, index) => { %>
                    <tr>
                      <td><%= index + 1 %></td>
                      <td><%= product.productName || 'Unknown Product' %></td>
                      <td><%= product.quantitySold %></td>
                      <td>₹<%= Number(product.revenue || 0).toLocaleString('en-IN') %></td>
                    </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
              <% } else { %>
              <p class="empty-state">No completed sales yet.</p>
              <% } %>
            </section>

            <section class="dashboard-card">
              <h3>Top 10 Best-Selling Categories</h3>

              <% if (topCategories.length) { %>
              <div class="dashboard-table-wrapper">
                <table class="dashboard-table">
                  <thead>
                    <tr>
                      <th>#</th>
                      <th>Category</th>
                      <th>Quantity Sold</th>
                      <th>Revenue</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% topCategories.forEach((category, index) => { %>
                    <tr>
                      <td><%= index + 1 %></td>
                      <td><%= category.categoryName %></td>
                      <td><%= category.quantitySold %></td>
                      <td>₹<%= Number(category.revenue || 0).toLocaleString('en-IN') %></td>
                    </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
              <% } else { %>
              <p class="empty-state">No category sales available yet.</p>
              <% } %>
            </section>
            <section class="dashboard-card sales-chart-card">
              <div class="chart-header">
                <div>
                  <h3>Sales Overview</h3>
                  <p>Revenue from delivered orders</p>
                </div>

                <div class="chart-filters">
                  <select id="salesPeriod">
                    <option value="daily">Daily</option>
                    <option value="monthly" selected>Monthly</option>
                    <option value="yearly">Yearly</option>
                  </select>

                  <select id="salesYear"></select>
                  <select id="salesMonth"></select>
                </div>
              </div>

              <div class="sales-chart-container">
                <canvas id="salesChart"></canvas>
              </div>
            </section>
          </div>
        </div>
      </main>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="/admin/js/dashboard.js"></script>
  </body>
</html>
