<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title><%= product.name %> | BuildaPC</title>

    <link rel="stylesheet" href="/user/css/home.css" />
    <link rel="stylesheet" href="/user/css/productDetails.css" />
  </head>
  <body>
    <%-include("../../views/partials/user/header.ejs")%>

    <main class="product-details-page">
      <div class="product-details-container">
        <div class="breadcrumb">
          <a href="/">Home</a>
          <span>/</span>
          <% if(product.productType ==='component'){ %>
          <a href="/products">PC Compontents</a>
          <% } else{%>
          <a href="/products/preBuilt">Pre-built PCs</a>
          <%}%>
          <span>/</span>
          <span class="breadcrumb-current"> <%= product.name %> </span>
        </div>
        <section class="product-main-card">
          <div class="product-gallery">
            <!-- MAIN IMAGE -->
            <div class="main-product-image" id="mainProductImageContainer">
              <img
                id="mainProductImage"
                src="<%= product.primaryImage %>"
                alt="<%= product.name %>"
              />
            </div>
            <!-- THUMBNAILS -->
            <div class="product-thumbnails">
              <!-- PRIMARY IMAGE -->
              <button
                type="button"
                class="thumbnail active"
                onclick="changeProductImage('<%= product.primaryImage %>', this)"
              >
                <img src="<%= product.primaryImage %>" alt="<%= product.name %>" />
              </button>
              <!-- SECONDARY IMAGES -->
              <% if (product.secondaryImages && product.secondaryImages.length > 0) { %> <%
              product.secondaryImages.forEach(image => { %>
              <button
                type="button"
                class="thumbnail"
                onclick="changeProductImage('<%= image %>', this)"
              >
                <img src="<%= image %>" alt="<%= product.name %>" />
              </button>
              <% }) %>
              <% } %>
            </div>
          </div>
          <!-- =============================================
                     RIGHT SIDE - PRODUCT INFORMATION
                ============================================== -->
          <div class="product-information">
            <!-- PRODUCT NAME -->
            <h1 class="product-title"><%= product.name %></h1>

            <!-- PRICE -->
            <% const hasVariants = product.variants && product.variants.length > 0; const
            initialVariant = hasVariants ? product.variants[0] : null; const initialOriginalPrice =
            Number( initialVariant ? initialVariant.originalPrice : product.originalPrice ); const
            initialFinalPrice = Number( initialVariant ? initialVariant.finalPrice :
            product.finalPrice ); const initialDiscountAmount = Number( initialVariant ?
            initialVariant.discountAmount : product.discountAmount ); const
            initialDiscountPercentage = Number( initialVariant ? initialVariant.discountPercentage :
            product.discountPercentage ); %>

            <div class="price-section" id="priceSection">
              <% if (initialDiscountAmount > 0) { %>
              <div class="product-offer-pricing">
                <span class="product-original-price" id="originalPrice">
                  ₹<%= initialOriginalPrice.toLocaleString('en-IN') %>
                </span>

                <span class="product-price discounted" id="productPrice">
                  ₹<%= initialFinalPrice.toLocaleString('en-IN') %>
                </span>

                <span class="product-offer-badge" id="productOfferBadge">
                  <%= initialDiscountPercentage %>% OFF
                </span>
              </div>
              <% } else { %>
              <div class="product-offer-pricing">
                <span class="product-original-price" id="originalPrice" hidden></span>

                <span class="product-price" id="productPrice">
                  ₹<%= Number(initialVariant ? initialVariant.price : product.basePrice
                  ).toLocaleString('en-IN') %>
                </span>

                <span class="product-offer-badge" id="productOfferBadge" hidden></span>
              </div>
              <% } %>

              <span class="tax-text">Inclusive of all taxes</span>
            </div>

            <!-- DESCRIPTION -->
            <% if (product.description) { %>
            <div class="product-description">
              <p>
                <%= product.description %>
              </p>
            </div>
            <% } %>
            <!-- FEATURES -->
            <% if (product.features) { %>
            <div class="product-features"><%- product.features %></div>
            <% } %>
            <!-- VARIANTS -->
            <% if (product.variants && product.variants.length > 0) { %>
            <div class="product-variants-section">
              <span class="variant-selection-label"> Available Options </span>
              <div class="product-variant-options">
                <% product.variants.forEach(variant => { %>
                <button
                  type="button"
                  class="product-variant-option <%=variant._id.toString()===product.variants[0]._id.toString()?'selected':''%>"
                  data-variant-id="<%= variant._id %>"
                  data-price="<%= variant.price %>"
                  data-stock="<%= variant.stock %>"
                  data-wishlist="<%= variant.isInWishlist %>"
                  data-original-price="<%= variant.originalPrice %>"
                  data-final-price="<%= variant.finalPrice %>"
                  data-discount-amount="<%= variant.discountAmount %>"
                  data-discount-percentage="<%= variant.discountPercentage %>"
                >
                  <div class="variant-option-details">
                    <% variant.attributes.forEach(attribute => { %>
                    <span class="variant-attribute">
                      <%= attribute.name %>: <%= attribute.value %>
                    </span>
                    <% }) %>
                  </div>
                  <span class="variant-option-price">
                    ₹<%= Number(variant.discountAmount>0 ?variant.finalPrice:variant.price
                    ).toLocaleString('en-IN') %>
                  </span>
                </button>
                <% }) %>
              </div>
            </div>
            <% } %>
            <!-- STOCK -->
            <%
                        const initialStock = hasVariants
                            ? product.variants[0].stock
                            : product.stockLevel;
                    %>
            <div class="stock-section">
              <% if (initialStock > 0) { %>
              <span class="stock-dot available"></span>
              <span class="stock-text" id="availableStockText" data-stock="<%=initialStock %>">
                <%= initialStock %> available
              </span>
              <% } else { %>
              <span class="stock-dot unavailable"></span>
              <span class="stock-text out-of-stock"> Out of stock </span>
              <% } %>
            </div>
            <!-- QUANTITY -->
            <% if (initialStock>0) { %>
            <div
              class="quantity-section"
              id="quantitySection"
              data-product-stock="<%=initialStock%>"
            >
              <span class="quantity-label"> Quantity </span>
              <div class="quantity-control">
                <button type="button" id="decreaseQuantity">−</button>
                <span id="quantity"> 1 </span>
                <button type="button" id="increaseQuantity">+</button>
              </div>
            </div>
            <% } %>
            <!-- ACTION BUTTONS -->
            <div class="product-actions">
              <% if (hasVariants) { %> <% if (initialStock <= 0) { %>
              <button
                type="button"
                id="add-cart-button"
                class="add-cart-button disabled"
                data-product-id="<%= product._id %>"
                disabled
              >
                Out of Stock
              </button>
              <% } else { %>
              <button
                type="button"
                id="add-cart-button"
                class="add-cart-button"
                data-product-id="<%= product._id %>"
              >
                Add to Cart
              </button>
              <% } %>

              <% } else if (product.stockLevel > 0) { %>

              <button
                type="button"
                id="add-cart-button"
                class="add-cart-button"
                data-product-id="<%= product._id %>"
              >
                Add to Cart
              </button>

              <% } else { %>

              <button type="button" class="add-cart-button disabled" disabled>Out of Stock</button>

              <% } %>
              <% let initialWishlist = false; if (product.variants && product.variants.length > 0) {
              initialWishlist = product.variants[0].isInWishlist; } else { initialWishlist =
              product.isInWishlist; } %>

              <button
                type="button"
                class="wishlist-button<% if (initialWishlist) { %> checked<% } %>"
                id="wishlist-button"
                data-product-id="<%= product._id %>"
                aria-label="Add to wishlist"
              >
                <span class="wishlist-icon">
                  <% if (initialWishlist) { %> ♥ <% } else { %> ♡ <% } %>
                </span>
              </button>
            </div>
          </div>
        </section>

        <% if (product.specifications && product.specifications.length > 0) { %>
        <section class="specifications-section">
          <h2>Specifications</h2>
          <div class="specifications-grid">
            <% product.specifications.forEach(specification => { %>
            <div class="specification-item">
              <span class="specification-name"> <%= specification.name %> </span>
              <span class="specification-value"> <%= specification.value %> </span>
            </div>
            <% }) %>
          </div>
        </section>
        <% } %>
        <!-- product review secion -->
        <div class="product-reviews-section">
          <h2>Customer Reviews</h2>
          <div class="rating-summary">
            <div class="average-rating">
              <strong>
                <%= ratingSummary.averageRating %>
              </strong>
              <span>★</span>
              <p><%= ratingSummary.totalReviews %> Reviews</p>
            </div>
          </div>
          <% if (reviews && reviews.length > 0) { %>
          <div class="reviews-list">
            <% reviews.forEach(review => { %>
            <div class="review-item">
              <div class="review-header">
                <strong>
                  <%= review.userId.name %>
                </strong>
                <span class="review-rating">
                  <% for (let i = 1; i <= 5; i++) { %> <%= i <= review.rating ? '★' : '☆' %> <% } %>
                </span>
              </div>
              <p class="review-comment"><%= review.comment %></p>
              <small>
                <%= new Date(review.createdAt).toLocaleDateString('en-IN') %>
              </small>
            </div>
            <% }) %>
          </div>
          <% } else { %>
          <p class="no-reviews">No reviews yet.</p>
          <% } %>
        </div>
        <!-- add review section -->
        <% if (user) { %>
        <div class="write-review-section">
          <h3>Write a Review</h3>
          <div class="review-star-input">
            <button type="button" data-rating="1">★</button>
            <button type="button" data-rating="2">★</button>
            <button type="button" data-rating="3">★</button>
            <button type="button" data-rating="4">★</button>
            <button type="button" data-rating="5">★</button>
          </div>
          <textarea id="reviewComment" placeholder="Write your review..."></textarea>

          <button type="button" id="submitReview" data-product-id="<%=product._id%>">
            Submit Review
          </button>
          <p id="reviewMessage"></p>
        </div>
        <% } else{ %>
        <div class="login-to-review">
          <p>Please login to review this product.</p>
        </div>
        <%}%>

        <% if (product.relatedProducts && product.relatedProducts.length > 0) { %>
        <section class="related-section">
          <div class="related-header">
            <h2>Related Products</h2>
            <div class="related-navigation">
              <button type="button" id="relatedPrevious">‹</button>
              <button type="button" id="relatedNext">›</button>
            </div>
          </div>
          <div class="related-products" id="relatedProducts">
            <% product.relatedProducts.forEach(relatedProduct => { %>
            <% if (relatedProduct.isListed !== false && relatedProduct.isDeleted !== true) { %>
            <article class="related-product-card">
              <!-- IMAGE -->
              <a href="/product/<%= relatedProduct._id %>" class="related-image-link">
                <img
                  src="<%= relatedProduct.primaryImage %>"
                  alt="<%= relatedProduct.name %>"
                  class="related-product-image"
                />
              </a>
              <!-- INFORMATION -->
              <div class="related-product-info">
                <span class="related-category"> Component </span>
                <a href="/product/<%= relatedProduct._id %>" class="related-product-name">
                  <%= relatedProduct.name %>
                </a>
                <div class="related-product-price">
                  ₹<%= Number(relatedProduct.basePrice).toLocaleString('en-IN') %>
                </div>
              </div>
            </article>
            <% } %>
            <% }) %>
          </div>
        </section>
        <% } %>
      </div>
    </main>
    <%- include("../../views/partials/user/footer.ejs") %>
    <script src="/user/js/productDetails.js"></script>
  </body>
</html>
