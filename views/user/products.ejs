<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>PC Components | BuildaPC</title>

    <!-- Your existing home.css -->
    <link rel="stylesheet" href="/user/css/home.css">

    <!-- Product listing page CSS -->
    <link rel="stylesheet" href="/user/css/products.css">
</head>

<body>
    <!-- =========================
         USER NAVBAR
    ========================== -->
    <%-include("../../views/partials/user/header.ejs")%>
    <!-- ========================
         PRODUCT LISTING PAGE
    ========================== -->
    <main class="products-page">
        <div class="products-container">
            <!-- Page title -->
            <h1 class="products-page-title">
                PC Components
            </h1>
            <div class="products-layout">
                <!-- =========================
                     FILTER SIDEBAR
                ========================== -->
                <aside class="product-filters">
                    <div class="filter-header">
                        <h2>Filters</h2>
                    </div>
                    <!-- Categories -->
                    <div class="filter-section">
                        <h3>Categories</h3>
                        <div class="category-filter-list">
                            <% if (categories && categories.length > 0) { %>
                                <% categories.forEach(categoryItem => { %>
                                    <label class="category-filter-item">
                                        <input
                                            type="checkbox"
                                            name="category"
                                            value="<%= categoryItem._id %>"
                                            <%= category.includes(categoryItem._id.toString())? 'checked' : '' %>
                                        >
                                        <span class="category-checkbox"></span>
                                        <span class="category-name">
                                            <%= categoryItem.name %>
                                        </span>
                                        <span class="category-count">
                                            (<%= categoryItem.productCount || 0 %>)
                                        </span>
                                    </label>
                                <% }) %>
                            <% } else { %>
                                <p class="no-filter-data">
                                    No categories available
                                </p>
                            <% } %>
                        </div>
                    </div>
                    <!-- Price -->
                    <div class="filter-section price-filter-section">
                        <h3>Price Range</h3>
                        <div class="price-inputs">
                            <div class="price-input-group">
                                <label for="minPrice">
                                    Min
                                </label>
                                <input
                                    type="number"
                                    id="minPrice"
                                    name="minPrice"
                                    placeholder="₹0"
                                    value="<%= minPrice || '' %>"
                                    min="0"
                                >
                            </div>
                            <div class="price-input-group">
                                <label for="maxPrice">
                                    Max
                                </label>
                                <input
                                    type="number"
                                    id="maxPrice"
                                    name="maxPrice"
                                    placeholder="₹1,00,000"
                                    value="<%= maxPrice || '' %>"
                                    min="0" >
                            </div>
                        </div>
                        <button
                            type="button"
                            class="apply-filter-btn"
                        >
                            Apply Filter
                        </button>
                    </div>
                </aside>
                <!-- =========================
                     PRODUCT CONTENT
                ========================== -->
                <section class="products-content">
                    <!-- =========================
                         TOP BAR
                    ========================== -->
                    <div class="products-toolbar">
                        <div class="product-result-count">

                            <% 
                                const startProduct =
                                    totalProducts > 0
                                        ? ((currentPage - 1) * 6) + 1
                                        : 0;

                                const endProduct =
                                    Math.min(
                                        currentPage * 6,
                                        totalProducts
                                    );
                            %>
                            <span>
                                Showing
                                <%= startProduct %>-<%= endProduct %>
                                of
                                <%= totalProducts %>
                                products
                            </span>
                        </div>
                        <!-- Sort -->
                        <div class="product-sort">

                            <label for="sortProducts">
                                Sort by:
                            </label>

                            <select
                                id="sortProducts"
                                name="sort">
                                <option
                                    value="price_asc"
                                    <%= sort === 'price_asc' ? 'selected' : '' %>
                                >
                                    Price: Low to High
                                </option>
                                <option
                                    value="price_desc"
                                    <%= sort === 'price_desc' ? 'selected' : '' %>
                                >
                                    Price: High to Low
                                </option>
                                <option
                                    value="name_asc"
                                    <%= sort === 'name_asc' ? 'selected' : '' %>
                                >
                                    A-Z
                                </option>
                                <option
                                    value="name_desc"
                                    <%= sort === 'name_desc' ? 'selected' : '' %>
                                >
                                    Z-A
                                </option>
                            </select>
                        </div>
                    </div>
                    <!-- =========================
                         ACTIVE SEARCH
                    ========================== -->
                    <% if (search) { %>
                        <div class="active-search">
                            <span>
                                Search results for:
                                <strong>"<%= search %>"</strong>
                            </span>
                            <a
                                href="/products"
                                class="clear-search"
                            >
                                Cancel
                            </a>
                        </div>
                    <% } %>
                    <!-- =========================
                         PRODUCT GRID
                    ========================== -->
                    <div class="products-grid">
                        <% if (products && products.length > 0) { %>
                            <% products.forEach(product => { %>
                                <article class="product-card">
                                    <!-- Product Image -->
                                    <a
                                        href="/product/<%= product._id %>"
                                        class="product-image-link"
                                    >
                                        <div class="product-image-container">
                                            <img
                                                src="<%= product.primaryImage %>"
                                                alt="<%= product.name %>"
                                                class="product-image"
                                            >
                                        </div>
                                    </a>
                                    <!-- Product Information -->
                                    <div class="product-card-body">
                                        <a
                                            href="/product/<%= product._id %>"
                                            class="product-name-link">
                                            <h2 class="product-name">
                                                <%= product.name %>
                                            </h2>
                                        </a>
                                    
                                        <% if (product.discountAmount > 0) { %>
                                            <div class="product-pricing">
                                        <p class="product-original-price">
                                            ₹<%= Number(product.originalPrice).toLocaleString('en-IN') %>
                                        </p>
                                        <p class="product-price discounted">
                                            ₹<%= Number(product.finalPrice).toLocaleString('en-IN') %>
                                        </p>
                                        <span class="product-offer-badge">
                                        <%= product.discountPercentage %>% OFF
                                        </span>
                                        </div>
                                        <% } else { %>
                                        <p class="product-price">
                                        ₹<%= Number(product.basePrice).toLocaleString('en-IN') %>
                                        </p>
                                        <% } %>
                                        <!-- Product Actions -->
                                        <div class="product-card-actions">
                                            <button
                                                type="button"
                                                class="add-cart-btn"
                                                data-product-id="<%= product._id %>"
                                                data-has-variants='<%= product.variantCount> 0 %>'>
                                                <span class="cart-icon">
                                                    🛒
                                                </span>
                                                <span>
                                                    Add to Cart
                                                </span>
                                            </button>
                                            <button
                                                type="button"
                                                class="wishlist-btn <%if(product.isInWishlist){%> checked<%}%>"
                                                data-product-id="<%= product._id %>"
                                                data-has-variants="<%=product.variantCount>0 %>"
                                                aria-label="Add to wishlist"
                                            >
                                                <span class="wishlist-icon">
                                                    <%= product.isInWishlist ? '♥' : '♡' %>
                                                </span>
                                            </button>
                                        </div>
                                    </div>
                                </article>
                            <% }) %>
                        <% } else { %>
                            <!-- No products -->
                            <div class="no-products">
                                <h2>
                                    No products found
                                </h2>
                                <p>
                                    Try changing your search or filters.
                                </p>

                                <a
                                    href="/products"
                                    class="clear-products-btn"
                                >
                                    Clear Filters
                                </a>
                            </div>
                        <% } %>
                    </div>
                    <!-- =========================
                         PAGINATION
                    ========================= -->
                    <% if (totalPages >1) { %>
                        <nav
                            class="product-pagination"
                            aria-label="Product pagination"
                        >
                            <% if (currentPage > 1) { %>
                                <a
                                    href="/products?page=<%= currentPage - 1 %>"
                                    class="pagination-btn"
                                >
                                    Previous
                                </a>
                            <% } else { %>
                                <span class="pagination-btn disabled">
                                    Previous
                                </span>
                            <% } %>
                            <% for (let i = 1; i <= totalPages; i++) { %>
                                <a
                                    href="/products?page=<%= i %>"
                                    class="pagination-number <%= currentPage === i ? 'active' : '' %>"
                                >
                                    <%= i %>
                                </a>
                            <% } %>
                            <% if (currentPage < totalPages) { %>
                                <a
                                    href="/products?page=<%= currentPage + 1 %>"
                                    class="pagination-btn"
                                >
                                    Next
                                </a>
                            <% } else { %>
                                <span class="pagination-btn disabled">
                                    Next
                                </span>
                            <% } %>
                        </nav>
                    <% } %>
                </section>
            </div>
        </div>
    </main>
    <%-include("../../views/partials/user/footer.ejs")%>

<script>
        const applyFilterBtn = document.querySelector('.apply-filter-btn')
        applyFilterBtn.addEventListener('click',function(){
        const selectedCategories = document.querySelectorAll('input[name="category"]:checked');
        const minPrice = document.getElementById('minPrice').value;
        const maxPrice = document.getElementById('maxPrice').value;
        console.log('category', selectedCategories);
        console.log('minPrice', minPrice);
        console.log('maxPrice', maxPrice);
        const params = new URLSearchParams();
        selectedCategories.forEach(category=>{
            params.append('category',category.value);
        })
        if(minPrice){
            params.set('minPrice',minPrice);
        }
        if(maxPrice){
            params.set('maxPrice',maxPrice);
        }
        window.location.href = `/products?${params.toString()}`;
    })
    
    const sortProduct = document.getElementById('sortProducts');
    sortProduct.addEventListener('change',function(){
        const params = new URLSearchParams(window.location.search);
        params.set('sort',this.value);
        window.location.href= `/products?${params.toString()}`;
    })
    document.querySelectorAll('.add-cart-btn').forEach(button=>{
        button.addEventListener('click',async function(){
            const productId = this.dataset.productId;
            const hasVariants =this.dataset.hasVariants==='true';
            if(hasVariants){
                showToastMessage('Please select a option from the product page','warning');
                setTimeout(() => {
                    window.location.href=`/product/${productId}`;
                }, 1000);
                return;
            }
            try{
                const response = await fetch('/cart',{
                    method:'POST',
                    headers:{'Content-Type':'application/json','Accept':'application/json'},
                    body:JSON.stringify({productId:productId,variantId:null,quantity:1})
                });
                const result = await response.json();
                if(!response.ok||!result.success){
                    showToastMessage(result.message,'error');
                    if(result.redirect){
                        setTimeout(() => {
                            window.location.href = result.redirect;
                        }, 1000);
                    }
                    return;
                }
                showToastMessage(result.message,'success');
                console.log('calling wishlist cleanup');
                await removeProductFromWishlist(productId);
            }catch(error){
                console.log('add to cart error',error)
                showToastMessage(error.message,'error')
            }
        })
    })
    const removeProductFromWishlist = async (productId)=>{
        try{
             const response= await fetch(`/account/wishlist/remove-if-exists/${productId}`,{
                method:'DELETE',
                headers:{'Accept':'application/json'}
            });
            const result = await response.json();
            console.log('wishlist removal response',result);
            if(!response.ok||!result.success){
                console.log('wishlist removal failed',result.message);
                return;
            }
            if(result.removed){
                console.log('product removed from wishlist');
            }else{
                console.log('product was not removed from wishlist')    ;
            }
            
        }catch(error){
            console.log('wishlist cleanup error',error);   
        }
    }
    document.querySelectorAll('.wishlist-btn').forEach(button=>{
        button.addEventListener('click',async function () {
          const productId = this.dataset.productId;
          const hasVariants = this.dataset.hasVariants==='true';
          if(hasVariants){
            showToastMessage('Please select a variant from the product page','warning');
            setTimeout(() => {
                window.location.href=`/product/${productId}`;
            }, 1000);
            return;
          }
          try{
            const response = await fetch('/account/wishlist',{
                method:'POST',
                headers:{'Content-type':'application/json','Accept':'application/json'},
                body:JSON.stringify({productId:productId})
            })
            const result = await response.json();
            if(!response.ok||!result.success){
                showToastMessage(result.message||'Failed to add product to wishlist','error');
                if(result.redirect){
                    setTimeout(() => {
                        window.location.href=result.redirect;
                    }, 1500);
                }
                return;
            }
            
            showToastMessage(result.message,'success');
            this.classList.add('checked');
            const icon =this.querySelector('.wishlist-icon');
            if(icon){icon.textContent='♥';}
            
          }catch(error){
            console.log('Add to wishlist error',error);
            showToastMessage(error.message,'error');
          }
        });
    });
    
    function showToastMessage(message,type){
        const toast = document.getElementById('toastMessage');
        const text = document.getElementById('toastMessageText');
         console.log('MESSAGE:', message);
         console.log('TYPE:', type);
        text.textContent = message;
        toast.classList.remove('success','error','show')
        toast.classList.add(type);
        toast.classList.add('show')
        setTimeout(() => {
            toast.classList.remove('show')
            toast.classList.remove('success')
            toast.classList.remove('error')
        }, 4000);
    }

</script>
</body>

</html>