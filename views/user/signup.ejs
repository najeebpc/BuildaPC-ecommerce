<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>BuildaPC - Sign Up</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    <link rel="stylesheet" href="/user/css/auth.css" />
  </head>
  <body>
    <div class="auth-page">
      <div class="auth-card">
        <div class="auth-header">
          <div class="auth-logo">BuildaPC</div>
          <h1 class="auth-title">Create an Account</h1>
          <p class="auth-subtext">Join us and start building your dream PC</p>
        </div>

        <form class="auth-form" id="signform" action="/signup" method="POST">
          <div class="form-group">
            <label for="name">Name</label>
            <input
              id="name"
              name="name"
              placeholder="Enter your name"
              value="<%= formData.name ||'' %>"
            />
            <p class="error-text" id="nameError">
              <% if(message&&field==='name'){ %> <%=message %> <% } %>
            </p>
          </div>

          <div class="form-group">
            <label for="email">Email</label>
            <input
              id="email"
              name="email"
              placeholder="Enter your email"
              value="<%= formData.email || '' %>"
            />
            <p class="error-text" id="mailerror">
              <% if(message&&field==='email'){ %> <%=message %> <% } %>
            </p>
          </div>

          <div class="form-group">
            <label for="password">Password</label>
            <div class="password-input-wrapper">
              <input
                type="password"
                id="password"
                name="password"
                placeholder="Enter your password"
              />
              <button
                type="button"
                class="password-toggle"
                title="show"
                onclick="togglePassword('password', this)"
              >
                👁
              </button>
            </div>
            <p class="error-text" id="passerror">
              <% if(message&&field==='password'){%> <%=message%> <% }%>
            </p>
            <p class="password-hint">
              Use 8+ characters with uppercase, lowercase, a number and a special character.
            </p>
          </div>

          <div class="form-group">
            <label for="confirmPassword">Confirm Password</label>
            <div class="password-input-wrapper">
              <input
                type="password"
                id="confirmPassword"
                name="cpassword"
                placeholder="Re-enter your password"
              />
              <button
                type="button"
                class="password-toggle"
                title="show"
                onclick="togglePassword('confirmPassword', this)"
              >
                👁
              </button>
            </div>
            <p class="error-text" id="cpasserror">
              <% if(message&&field==='cpass'){%> <%=message%> <% }%>
            </p>
          </div>

          <div class="form-group">
            <label for="referral">Referral Code (Optional)</label>

            <div class="referral-wrapper">
              <img src="user/icons/referral.svg" class="referral-icon" alt="referral" />
              <input
                type="text"
                id="referral"
                name="referralCode"
                value="<%=(typeof referralCode !=='undefined'?referralCode:'')||formData?.referralCode||''%>"
                placeholder="Enter referral code if you have one"
              />
              <p class="error-text" id="mailerror">
                <% if(message&&field==='referralCode'){ %> <%=message %> <% } %>
              </p>
            </div>
          </div>

          <button type="submit" class="btn-primary" id="signupBtn">Sign Up</button>
        </form>

        <div class="divider">
          <span>or continue with</span>
        </div>

        <a href="/auth/google"
          ><button type="button" class="btn-google">Continue with Google</button></a
        >

        <div class="auth-footer">Already have an account? <a href="/login">Login</a></div>
      </div>
    </div>
    <script src="/user/js/signup.js"></script>
  </body>
</html>
