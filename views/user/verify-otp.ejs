<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>BuildaPC - Verify Security Code</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    <link rel="stylesheet" href="user/css/auth.css" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  </head>
  <body>
    <div class="auth-page">
      <div class="auth-card">
        <div class="auth-header">
          <div class="auth-logo">BuildaPC</div>
          <h1 class="auth-title">Verify Security Code</h1>
          <p class="auth-subtext">Please enter the 6-digit code sent to your email address.</p>
        </div>

        <form id="otpform" class="auth-form">
          <div class="form-group">
            <label>Verification Code</label>

            <div class="code-inputs">
              <input type="text" maxlength="1" class="code-box" />
              <input type="text" maxlength="1" class="code-box" />
              <input type="text" maxlength="1" class="code-box" />
              <input type="text" maxlength="1" class="code-box" />
              <input type="text" maxlength="1" class="code-box" />
              <input type="text" maxlength="1" class="code-box" />
            </div>
            <p id="otpMessage" class="otp-message"></p>
          </div>

          <button type="button" onclick="return validateOtpForm();" class="btn-primary">
            Verify
          </button>
        </form>

        <div class="resend-wrapper">
          <span id="timer-text">
            Resend code in <strong><span id="timer">60</span>s</strong>
          </span>
          <a href="#" id="resend-Link" class="resend-link disabled">Resend Code</a>
        </div>
      </div>
    </div>
    <div id="timer-container" data-expires-at="<%=expiresAt.toISOString()%>"></div>
  </body>
  <script src="/user/js/verify-otp.js"></script>
</html>
